# Copy to .env. Never commit .env.
# scripts/new-key.sh NAME_PRIVATE_KEY... makes a fresh key, writes it here and prints only its address.

# Facilitator signer per chain. It only pays gas: settlement moves tokens payer -> payTo
# by signature, so this wallet never receives or holds payment funds.
# On testnet the same key also deploys the canonical contracts (contracts/README.md).
FACILITATOR_TESTNET_PRIVATE_KEY=
# Required with any config that includes mainnet: config.json or config.mainnet.json.
FACILITATOR_MAINNET_PRIVATE_KEY=

# Where docker compose publishes the facilitator. The default reaches this machine only. /settle has
# no authentication and the signer pays its gas, so read README "The facilitator" before widening it.
# FACILITATOR_BIND=127.0.0.1
# FACILITATOR_PORT=8080

# RPCs. Defaults (docker-compose.yml): dRPC primary, Hemi public RPC fallback.
# HEMI_TESTNET_RPC_PRIMARY=https://hemi-testnet.drpc.org
# HEMI_TESTNET_RPC_FALLBACK=https://testnet.rpc.hemi.network/rpc
# HEMI_MAINNET_RPC_PRIMARY=https://hemi.drpc.org
# HEMI_MAINNET_RPC_FALLBACK=https://rpc.hemi.network/rpc

# Demo seller (seller/). npm scripts load this file; variables set in the shell win.
SELLER_PAY_TO=
# FACILITATOR_URL=http://localhost:8080
# SELLER_NETWORKS=eip155:743111            # comma-separated; add eip155:43111 for mainnet
# SELLER_BTC_AMOUNT=1                      # satoshis per call (~$0.001 at ~$100k/BTC)
# PORT=4021

# Demo buyer (buyer/).
BUYER_PRIVATE_KEY=
# BUYER_RPC_URL=                           # default: dRPC with the Hemi public RPC as fallback
# SELLER_URL=http://localhost:4021/echo?hello=hemi
# ALLOW_MAINNET=yes                        # required for --network mainnet

# Contract deployment (contracts/deploy.sh). On testnet FACILITATOR_TESTNET_PRIVATE_KEY is used
# if this is empty; on mainnet this must be set and must differ from the testnet key.
# DEPLOYER_PRIVATE_KEY=
# CONFIRM_MAINNET_DEPLOY=yes               # required for a mainnet --broadcast
