@@ -20,6 +20,14 @@ describe("defaultAssets (EVM)", () => {
       expect(findDefaultAsset(BASE_USDC.asset, "base")).toEqual(BASE_USDC);
     });
 
+    it("resolves v1 legacy network names hemi and hemi-testnet", () => {
+      const hemiUsdce = DEFAULT_ASSETS["eip155:43111"]![0]!;
+      const hemiTestnetUsdce = DEFAULT_ASSETS["eip155:743111"]![0]!;
+
+      expect(findDefaultAsset(hemiUsdce.asset, "hemi")).toEqual(hemiUsdce);
+      expect(findDefaultAsset(hemiTestnetUsdce.asset, "hemi-testnet")).toEqual(hemiTestnetUsdce);
+    });
+
     it("finds 18-decimal mUSD on Mezo testnet", () => {
       expect(findDefaultAsset(MEZO_TESTNET_MUSD.asset, "eip155:31611")).toEqual(MEZO_TESTNET_MUSD);
       expect(MEZO_TESTNET_MUSD.decimals).toBe(18);
diff --git a/typescript/packages/mechanisms/evm/test/unit/server.test.ts b/typescript/packages/mechanisms/evm/test/unit/server.test.ts
index 1119eae..e0c8c59 100644
--- a/typescript/packages/mechanisms/evm/test/unit/server.test.ts
+++ b/typescript/packages/mechanisms/evm/test/unit/server.test.ts
@@ -80,6 +80,29 @@ describe("ExactEvmScheme (Server)", () => {
       });
     });
 
+    describe("Hemi network", () => {
+      const network = "eip155:43111";
+
+      it("should use Hemi mainnet USDC.e with its EIP-712 domain", async () => {
+        const result = await server.parsePrice("$0.001", network);
+        expect(result.asset).toBe("0xad11a8BEb98bbf61dbb1aa0F6d6F2ECD87b35afA");
+        expect(result.amount).toBe("1000");
+        expect(result.extra).toEqual({ name: "Bridged USDC (Stargate)", version: "2" });
+        expect(result.extra).not.toHaveProperty("assetTransferMethod");
+      });
+    });
