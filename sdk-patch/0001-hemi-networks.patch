diff --git a/docs/core-concepts/network-and-token-support.mdx b/docs/core-concepts/network-and-token-support.mdx
index 4bac80c..8ebd1ba 100644
--- a/docs/core-concepts/network-and-token-support.mdx
+++ b/docs/core-concepts/network-and-token-support.mdx
@@ -147,6 +147,8 @@ When you use `"$0.01"` syntax, x402 needs to know which stablecoin to use. The f
 | Arc | `eip155:5042` | `0x3600000000000000000000000000000000000000` | USDC | 6 | EIP-3009 |
 | Arc Testnet | `eip155:5042002` | `0x3600000000000000000000000000000000000000` | USDC | 6 | EIP-3009 |
 | Robinhood Chain | `eip155:4663` | `0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168` | Global Dollar | 6 | EIP-3009 |
+| Hemi | `eip155:43111` | `0xad11a8BEb98bbf61dbb1aa0F6d6F2ECD87b35afA` | Bridged USDC (Stargate) | 6 | EIP-3009 |
+| Hemi Testnet | `eip155:743111` | `0xD47971C7F5B1067d25cd45d30b2c9eb60de96443` | USDC.e | 6 | Permit2 |
 
 
 
diff --git a/typescript/.changeset/add-hemi-default-stablecoin.md b/typescript/.changeset/add-hemi-default-stablecoin.md
new file mode 100644
index 0000000..08e052c
--- /dev/null
+++ b/typescript/.changeset/add-hemi-default-stablecoin.md
@@ -0,0 +1,5 @@
+---
+'@x402/evm': minor
+---
+
+Add Hemi mainnet (chain ID 43111) and Hemi Testnet (chain ID 743111) with USDC.e as the default stablecoin, and the v1 network names `hemi` and `hemi-testnet`.
diff --git a/typescript/packages/mechanisms/evm/src/constants.ts b/typescript/packages/mechanisms/evm/src/constants.ts
index ab7db42..a0a0db9 100644
--- a/typescript/packages/mechanisms/evm/src/constants.ts
+++ b/typescript/packages/mechanisms/evm/src/constants.ts
@@ -24,6 +24,8 @@ export const EVM_NETWORK_CHAIN_ID_MAP = {
   "stable-testnet": 2201,
   celo: 42220,
   flare: 14,
+  hemi: 43111,
+  "hemi-testnet": 743111,
 } as const;
 
 export type EvmNetworkV1 = keyof typeof EVM_NETWORK_CHAIN_ID_MAP;
diff --git a/typescript/packages/mechanisms/evm/src/defaultAssets.ts b/typescript/packages/mechanisms/evm/src/defaultAssets.ts
index 0a11f26..6d89276 100644
--- a/typescript/packages/mechanisms/evm/src/defaultAssets.ts
+++ b/typescript/packages/mechanisms/evm/src/defaultAssets.ts
@@ -333,6 +333,25 @@ export const DEFAULT_ASSETS: DefaultAssetTable<ExactDefaultAssetInfo> = {
       symbol: "USDG",
     },
   ], // Robinhood Chain mainnet USDG (EIP-3009 supported)
+  "eip155:43111": [
+    {
+      asset: "0xad11a8BEb98bbf61dbb1aa0F6d6F2ECD87b35afA",
+      name: "Bridged USDC (Stargate)",
+      version: "2",
+      decimals: 6,
+      symbol: "USDC.e",
+    },
+  ], // Hemi mainnet USDC.e (EIP-3009 supported)
+  "eip155:743111": [
+    {
+      asset: "0xD47971C7F5B1067d25cd45d30b2c9eb60de96443",
+      name: "USDC.e",
+      version: "1",
+      decimals: 6,
+      symbol: "USDC.e",
+      assetTransferMethod: "permit2",
+    },
+  ], // Hemi testnet USDC.e (no EIP-3009, no EIP-2612)
 };
 
 /**
diff --git a/typescript/packages/mechanisms/evm/test/unit/defaultAssets.test.ts b/typescript/packages/mechanisms/evm/test/unit/defaultAssets.test.ts
