 .../.changeset/add-hemi-default-stablecoin.md |  5 ++++
 .../packages/mechanisms/evm/src/constants.ts  |  2 ++
 .../mechanisms/evm/src/defaultAssets.ts       | 19 +++++++++++++++
 .../evm/test/unit/defaultAssets.test.ts       |  8 +++++++
 .../mechanisms/evm/test/unit/server.test.ts   | 23 +++++++++++++++++++
