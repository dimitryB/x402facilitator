+/// Verifies that the authorized `value` is exactly the required amount, as the `exact` scheme
+/// demands (x402 v2 §9 `invalid_exact_evm_payload_authorization_value_mismatch`: "Payment amount
+/// does not exactly match the required amount"). Over-authorizing is rejected too: the facilitator
+/// would otherwise settle more than the resource costs.
+#[cfg_attr(feature = "telemetry", instrument(skip_all, err, fields(
+    sent = %sent,
+    amount_required = %amount_required
+)))]
+pub fn assert_exact_value<V>(sent: &V, amount_required: &V) -> Result<(), PaymentVerificationError>
+where
+    V: Display + Eq,
+{
+    if sent != amount_required {
+        Err(PaymentVerificationError::InvalidPaymentAmount)
+    } else {
+        Ok(())
+    }
+}
+
 /// Canonical data required to verify a signature.
 #[derive(Debug, Clone)]
 pub struct SignedMessage {
@@ -1481,6 +1500,18 @@ mod tests {
         ));
     }
 
+    #[test]
+    fn exact_value_rejects_both_under_and_over_payment() {
+        let required = U256::from(1000);
+        assert!(assert_exact_value(&U256::from(1000), &required).is_ok());
+        for sent in [999u64, 1001, 5000] {
+            assert!(matches!(
+                assert_exact_value(&U256::from(sent), &required),
+                Err(PaymentVerificationError::InvalidPaymentAmount)
+            ));
+        }
+    }
