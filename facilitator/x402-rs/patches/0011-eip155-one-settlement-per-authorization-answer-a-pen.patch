+//! Payment authorizations that are being settled, or whose settlement transaction was broadcast but
+//! not confirmed in time (`settlement_pending`).
+//!
+//! x402 v2 §9 makes `settlement_pending` non-terminal: the caller is expected to reconcile and may send
+//! the same settle request again (the TS SDK's resource server retries once, immediately). Without a
+//! record of the first attempt, that retry would be settled from scratch: a second transaction, or
+//! `invalid_transaction_state` once the first one has spent the nonce.
+//!
+//! [`PendingSettlements`] keeps one record per payment authorization (chain, payer, EIP-3009 or Permit2
+//! nonce) from the start of a settle until its outcome is known:
+//!
+//! - While a record exists, `/verify` of that authorization is rejected, and so is `/settle` of any other
+//!   request for it: the authorization is already committed to a settlement, so it must not pay for
+//!   anything else.
+//! - A settle that ends in anything but `settlement_pending` removes its record when it returns.
+//! - A retry of the very same request is answered from the pending transaction: `settlement_pending` with
+//!   the same hash while it is unmined. Once it is mined, the first retry that sees the receipt claims the
+//!   record ([`PendingSettlements::claim`], atomic) and gets the success. Every later settle of the payload
+//!   finds no record and is an ordinary replay (`invalid_transaction_state`). A reverted transaction
+//!   removes the record as well.
+//!
+//! Records live in memory, are bounded and expire.
+
+use alloy_primitives::{B256, TxHash, keccak256};
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex, MutexGuard};
+use std::time::{Duration, Instant};
+
+use crate::v2_eip155_exact::types::FacilitatorSettleRequest;
+
+/// Identifies a payment authorization: chain, payer and nonce. Two requests carrying the same signed
+/// authorization have the same id, whatever else differs between them.
+pub fn payment_id(request: &FacilitatorSettleRequest) -> B256 {
+    let id = match request {
+        FacilitatorSettleRequest::Eip3009 {
+            payment_payload, ..
+        } => {
+            let authorization = &payment_payload.payload.authorization;
+            format!(
+                "{}/eip3009/{}/{}",
+                payment_payload.accepted.network, authorization.from, authorization.nonce
+            )
+        }
+        FacilitatorSettleRequest::Permit2 {
+            payment_payload, ..
+        } => {
+            let authorization = &payment_payload.payload.permit_2_authorization;
+            format!(
+                "{}/permit2/{}/{}",
+                payment_payload.accepted.network, authorization.from, authorization.nonce
+            )
+        }
+    };
+    keccak256(id.to_lowercase())
+}
+
+/// Identifies a settle request: the hash of the parsed request (payload, signature and requirements),
+/// so that only the very same payment, retried, is answered from the remembered transaction.
+pub fn request_key(request: &FacilitatorSettleRequest) -> B256 {
+    keccak256(serde_json::to_vec(request).unwrap_or_default())
+}
+
+/// The record of an authorization being settled.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Record {
+    /// [`request_key`] of the settle request that started it.
+    pub request: B256,
+    /// The broadcast transaction, once the settle ended in `settlement_pending`; `None` while the
+    /// settle is still running.
+    pub transaction: Option<TxHash>,
+    since: Instant,
+}
+
+/// In-memory, bounded and expiring map from payment authorization to its settlement.
+#[derive(Debug, Clone)]
+pub struct PendingSettlements {
+    records: Arc<Mutex<HashMap<B256, Record>>>,
+    ttl: Duration,
+    capacity: usize,
+}
+
+impl Default for PendingSettlements {
+    fn default() -> Self {
+        Self::new(Self::DEFAULT_TTL, Self::DEFAULT_CAPACITY)
+    }
+}
+
+impl PendingSettlements {
+    /// How long a record is kept. Longer than any receipt timeout, and long enough for a client to
+    /// retry; after that a retry is settled afresh (and fails on the spent nonce).
+    pub const DEFAULT_TTL: Duration = Duration::from_secs(15 * 60);
+    /// At most this many records are kept; the oldest are dropped first.
+    pub const DEFAULT_CAPACITY: usize = 10_000;
+
+    pub fn new(ttl: Duration, capacity: usize) -> Self {
+        Self {
+            records: Arc::new(Mutex::new(HashMap::new())),
+            ttl,
+            capacity: capacity.max(1),
+        }
+    }
+
+    /// The records, with expired ones dropped.
+    fn records(&self) -> MutexGuard<'_, HashMap<B256, Record>> {
+        let mut records = self.records.lock().unwrap_or_else(|e| e.into_inner());
+        let now = Instant::now();
+        records.retain(|_, record| now.duration_since(record.since) < self.ttl);
+        records
+    }
+
+    /// The record of authorization `id`, if it is being settled or its settlement is pending.
+    pub fn get(&self, id: &B256) -> Option<Record> {
+        self.records().get(id).copied()
+    }
+
+    /// Starts settling authorization `id` with the request `request`. Fails with the existing record if
+    /// the authorization is already being settled or pending. The returned guard removes the record
+    /// when dropped, unless [`InFlight::pending`] recorded a broadcast transaction first.
+    pub fn begin(&self, id: B256, request: B256) -> Result<InFlight<'_>, Record> {
+        let mut records = self.records();
+        if let Some(record) = records.get(&id) {
+            return Err(*record);
+        }
+        if records.len() >= self.capacity
+            && let Some(oldest) = records
+                .iter()
+                .min_by_key(|(_, record)| record.since)
+                .map(|(id, _)| *id)
+        {
+            records.remove(&oldest);
+        }
+        records.insert(
+            id,
+            Record {
+                request,
+                transaction: None,
+                since: Instant::now(),
+            },
+        );
+        Ok(InFlight { store: self, id })
+    }
+
+    /// Removes the record of `id` if it still names `transaction`, and says whether it did. Only one
+    /// caller can win this for a given record, so only one retry is answered with the success.
+    pub fn claim(&self, id: &B256, transaction: TxHash) -> bool {
+        let mut records = self.records();
+        if records
+            .get(id)
+            .is_some_and(|record| record.transaction == Some(transaction))
+        {
+            records.remove(id);
+            true
+        } else {
+            false
+        }
+    }
+}
+
+/// A settle in progress for one authorization (see [`PendingSettlements::begin`]).
+#[derive(Debug)]
+pub struct InFlight<'a> {
+    store: &'a PendingSettlements,
+    id: B256,
+}
+
+impl InFlight<'_> {
+    /// The settle ended in `settlement_pending` with `transaction`: keep the record, now naming it.
+    pub fn pending(&self, transaction: TxHash) {
+        if let Some(record) = self.store.records().get_mut(&self.id) {
+            record.transaction = Some(transaction);
+        }
+    }
+}
+
+impl Drop for InFlight<'_> {
+    fn drop(&mut self) {
+        let mut records = self.store.records();
+        if records
+            .get(&self.id)
+            .is_some_and(|record| record.transaction.is_none())
+        {
+            records.remove(&self.id);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const ID: B256 = B256::repeat_byte(1);
+    const REQUEST: B256 = B256::repeat_byte(2);
+
+    #[test]
+    fn a_settle_holds_its_authorization_until_it_ends() {
+        let store = PendingSettlements::default();
+        let guard = store.begin(ID, REQUEST).unwrap();
+        // Meanwhile the authorization cannot start another settlement, and verify sees it.
+        assert_eq!(store.begin(ID, REQUEST).unwrap_err().transaction, None);
+        assert!(store.get(&ID).is_some());
+        drop(guard);
+        assert!(store.get(&ID).is_none());
+    }
+
+    #[test]
+    fn a_pending_settlement_is_kept_and_claimed_exactly_once() {
+        let store = PendingSettlements::default();
+        let tx = TxHash::repeat_byte(0xaa);
+        store.begin(ID, REQUEST).unwrap().pending(tx);
+        let record = store.get(&ID).unwrap();
+        assert_eq!((record.request, record.transaction), (REQUEST, Some(tx)));
+        assert!(!store.claim(&ID, TxHash::repeat_byte(0xbb)));
+        assert!(store.claim(&ID, tx));
+        assert!(!store.claim(&ID, tx));
+        assert!(store.get(&ID).is_none());
+    }
+
+    #[test]
+    fn records_expire_and_the_oldest_goes_when_full() {
+        let expired = PendingSettlements::new(Duration::ZERO, 10);
+        expired.begin(ID, REQUEST).unwrap().pending(TxHash::ZERO);
+        assert!(expired.get(&ID).is_none());
+
+        let full = PendingSettlements::new(Duration::from_secs(60), 2);
+        for i in 1..=3u8 {
+            full.begin(B256::repeat_byte(i), REQUEST)
+                .unwrap()
+                .pending(TxHash::repeat_byte(i));
+        }
+        assert!(full.get(&B256::repeat_byte(1)).is_none());
+        assert!(full.get(&B256::repeat_byte(3)).is_some());
+    }
+
+    fn request(signature: &str, pay_to: &str) -> FacilitatorSettleRequest {
+        let requirements = format!(
+            r#"{{"scheme":"exact","network":"eip155:43111","amount":"1000","asset":"0xad11a8BEb98bbf61dbb1aa0F6d6F2ECD87b35afA","payTo":"{pay_to}","maxTimeoutSeconds":300,"extra":{{"assetTransferMethod":"eip3009","name":"Bridged USDC (Stargate)","version":"2"}}}}"#
+        );
+        let json = format!(
+            r#"{{"x402Version":2,"paymentPayload":{{"x402Version":2,"accepted":{requirements},"payload":{{"signature":"{signature}","authorization":{{"from":"0x90F79bf6EB2c4f870365E785982E1f101E93b906","to":"0x000000000000000000000000000000000000dEaD","value":"1000","validAfter":"0","validBefore":"9999999999","nonce":"0x{nonce}"}}}}}},"paymentRequirements":{requirements}}}"#,
+            nonce = "22".repeat(32),
+        );
+        serde_json::from_str(&json).unwrap()
+    }
+
+    #[test]
+    fn ids_follow_the_authorization_and_keys_the_whole_request() {
+        let dead = "0x000000000000000000000000000000000000dEaD";
+        let other = "0x000000000000000000000000000000000000bEEF";
+        let a = format!("0x{}1b", "11".repeat(64));
+        let b = format!("0x{}1c", "11".repeat(64));
+        assert_eq!(
+            request_key(&request(&a, dead)),
+            request_key(&request(&a, dead))
+        );
+        assert_ne!(
+            request_key(&request(&a, dead)),
+            request_key(&request(&b, dead))
+        );
+        // Same payer and nonce: the same authorization, even inside a different request.
+        assert_eq!(
+            payment_id(&request(&a, dead)),
+            payment_id(&request(&b, other))
+        );
+    }
+}
