 }
 
+/// Rejects a signature that only an EIP-1271 contract could validate when `signer` has no code.
+///
+/// [`StructuredSignature::try_from_bytes`] treats a 64/65-byte signature that does not recover to the
+/// expected signer as an EIP-1271 signature, so that smart wallets keep working. An address without code
+/// cannot validate EIP-1271 signatures, so for such a signer the signature is simply invalid. Checking
+/// this before the simulation reports an invalid signature, rather than an opaque simulation failure,
+/// and never sends a transaction for it. Counterfactual wallets are not affected: their signatures are
+/// EIP-6492-wrapped and never take this path.
+pub async fn assert_eip1271_signer_has_code<P: Provider>(
+    provider: &P,
+    signer: &Address,
+) -> Result<(), Eip155ExactError> {
+    if is_contract_deployed(provider, signer).await? {
+        Ok(())
+    } else {
+        Err(PaymentVerificationError::InvalidSignature(format!(
+            "Signature was not made by {signer}, which has no code to validate it as an EIP-1271 signature"
+        ))
+        .into())
+    }
+}
+
 pub async fn verify_payment<P: Provider>(
     provider: &P,
     contract: &IEIP3009::IEIP3009Instance<&P>,
@@ -810,6 +832,7 @@ pub async fn verify_payment<P: Provider>(
                 .map_err(|e| PaymentVerificationError::TransactionSimulation(e.to_string()))?;
         }
         StructuredSignature::EIP1271(signature) => {
+            assert_eip1271_signer_has_code(provider, &payer).await?;
             // It is EIP-1271 signature, which we can pass to the transfer simulation
             let transfer_call = TransferWithAuthorization0Call::new(contract, payment, signature);
             let transfer_call = transfer_call.0;
@@ -945,6 +968,7 @@ where
             }
         }
         StructuredSignature::EIP1271(eip1271_signature) => {
+            assert_eip1271_signer_has_code(provider.inner(), &payer).await?;
             let transfer_call =
                 TransferWithAuthorization0Call::new(contract, payment, eip1271_signature);
             let transfer_call = transfer_call.0;
@@ -1114,3 +1138,59 @@ impl From<alloy_contract::Error> for Eip155ExactError {
         }
     }
 }
