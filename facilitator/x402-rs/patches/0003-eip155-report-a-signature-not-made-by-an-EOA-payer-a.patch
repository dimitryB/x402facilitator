+#[cfg(test)]
+mod tests {
+    use super::*;
+    use x402_types::proto::{AsPaymentProblem, ErrorReason};
+
+    #[test]
+    fn signature_failures_use_the_exact_evm_spec_code() {
+        let error =
+            exact_evm_error(PaymentVerificationError::InvalidSignature("bad".into()).into());
+        assert_eq!(
+            error.as_payment_problem().reason(),
+            ErrorReason::InvalidExactEvmPayloadSignature
+        );
+        assert_eq!(error.as_payment_problem().details(), "bad");
+        let other = exact_evm_error(PaymentVerificationError::InsufficientFunds.into());
+        assert_eq!(
+            other.as_payment_problem().reason(),
+            ErrorReason::InsufficientFunds
+        );
+    }
+}
