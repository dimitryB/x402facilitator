@@ -0,0 +1,142 @@
+//! Settlements whose transaction was broadcast but not confirmed in time (`settlement_pending`).
+//!
+//! x402 v2 §9 makes `settlement_pending` non-terminal: the caller is expected to reconcile and may
+//! send the same settle request again (the TS SDK's resource server retries once, immediately). Without
+//! a record of the first attempt, that retry is settled from scratch: a second transaction, or
+//! `invalid_transaction_state` once the first one has spent the nonce. [`PendingSettlements`] remembers
+//! the transaction of each pending request, so a retry is answered from that transaction instead.
+
+use alloy_primitives::{B256, TxHash, keccak256};
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+use x402_types::scheme::X402SchemeFacilitatorError;
+
+use crate::v2_eip155_exact::types::FacilitatorSettleRequest;
+
+/// Identifies a settle request: the hash of the parsed request (payload, signature and requirements),
+/// so that only the very same payment, retried, is answered from the remembered transaction.
+pub fn settlement_key(request: &FacilitatorSettleRequest) -> B256 {
+    keccak256(serde_json::to_vec(request).unwrap_or_default())
+}
+
+/// In-memory, bounded and expiring map from settle request to its broadcast transaction.
+#[derive(Debug, Clone)]
+pub struct PendingSettlements {
+    entries: Arc<Mutex<HashMap<B256, (TxHash, Instant)>>>,
+    ttl: Duration,
+    capacity: usize,
+}
+
+impl Default for PendingSettlements {
+    fn default() -> Self {
+        Self::new(Self::DEFAULT_TTL, Self::DEFAULT_CAPACITY)
+    }
+}
+
+impl PendingSettlements {
+    /// How long a pending settlement is remembered. Longer than any receipt timeout, and long enough
+    /// for a client to retry; after that a retry is settled afresh (and fails on the spent nonce).
+    pub const DEFAULT_TTL: Duration = Duration::from_secs(15 * 60);
+    /// At most this many pending settlements are remembered; the oldest are forgotten first.
+    pub const DEFAULT_CAPACITY: usize = 10_000;
+
+    pub fn new(ttl: Duration, capacity: usize) -> Self {
+        Self {
+            entries: Arc::new(Mutex::new(HashMap::new())),
+            ttl,
+            capacity: capacity.max(1),
+        }
+    }
+
+    /// The transaction a still-remembered request was settled into, if any.
+    pub fn get(&self, key: &B256) -> Option<TxHash> {
+        let mut entries = self.entries.lock().unwrap_or_else(|e| e.into_inner());
+        let now = Instant::now();
+        entries.retain(|_, (_, since)| now.duration_since(*since) < self.ttl);
+        entries.get(key).map(|(tx_hash, _)| *tx_hash)
+    }
+
+    /// Remembers `tx_hash` for `key`, forgetting expired entries and, if still full, the oldest one.
+    pub fn insert(&self, key: B256, tx_hash: TxHash) {
+        let mut entries = self.entries.lock().unwrap_or_else(|e| e.into_inner());
+        let now = Instant::now();
+        entries.retain(|_, (_, since)| now.duration_since(*since) < self.ttl);
+        if entries.len() >= self.capacity
+            && !entries.contains_key(&key)
+            && let Some(oldest) = entries
+                .iter()
+                .min_by_key(|(_, (_, since))| *since)
+                .map(|(key, _)| *key)
+        {
+            entries.remove(&oldest);
+        }
+        entries.insert(key, (tx_hash, now));
+    }
+
+    /// Remembers the transaction of a settle that ended in `settlement_pending`.
+    pub fn remember(&self, key: B256, error: &X402SchemeFacilitatorError) {
+        if let X402SchemeFacilitatorError::SettlementPending { transaction, .. } = error
+            && let Ok(tx_hash) = transaction.parse::<TxHash>()
+        {
+            self.insert(key, tx_hash);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn pending(transaction: TxHash) -> X402SchemeFacilitatorError {
+        X402SchemeFacilitatorError::SettlementPending {
+            transaction: transaction.to_string(),
+            details: "timeout".to_string(),
+        }
+    }
+
+    #[test]
+    fn remembers_only_pending_settlements() {
+        let store = PendingSettlements::default();
+        let tx = TxHash::repeat_byte(0xaa);
+        store.remember(B256::repeat_byte(1), &pending(tx));
+        store.remember(
+            B256::repeat_byte(2),
+            &X402SchemeFacilitatorError::OnchainFailure("x".to_string()),
+        );
+        assert_eq!(store.get(&B256::repeat_byte(1)), Some(tx));
+        assert_eq!(store.get(&B256::repeat_byte(2)), None);
+    }
+
+    #[test]
+    fn forgets_expired_entries_and_the_oldest_when_full() {
+        let expired = PendingSettlements::new(Duration::ZERO, 10);
+        expired.insert(B256::repeat_byte(1), TxHash::repeat_byte(1));
+        assert_eq!(expired.get(&B256::repeat_byte(1)), None);
+
+        let full = PendingSettlements::new(Duration::from_secs(60), 2);
+        for i in 1..=3u8 {
+            full.insert(B256::repeat_byte(i), TxHash::repeat_byte(i));
+        }
+        assert_eq!(full.get(&B256::repeat_byte(1)), None);
+        assert_eq!(
+            full.get(&B256::repeat_byte(3)),
+            Some(TxHash::repeat_byte(3))
+        );
+    }
+
+    #[test]
+    fn the_key_identifies_the_whole_request() {
+        let request = |signature: &str| -> FacilitatorSettleRequest {
+            let json = format!(
+                r#"{{"x402Version":2,"paymentPayload":{{"x402Version":2,"accepted":{{"scheme":"exact","network":"eip155:43111","amount":"1000","asset":"0xad11a8BEb98bbf61dbb1aa0F6d6F2ECD87b35afA","payTo":"0x000000000000000000000000000000000000dEaD","maxTimeoutSeconds":300,"extra":{{"assetTransferMethod":"eip3009","name":"Bridged USDC (Stargate)","version":"2"}}}},"payload":{{"signature":"{signature}","authorization":{{"from":"0x90F79bf6EB2c4f870365E785982E1f101E93b906","to":"0x000000000000000000000000000000000000dEaD","value":"1000","validAfter":"0","validBefore":"9999999999","nonce":"0x{nonce}"}}}}}},"paymentRequirements":{{"scheme":"exact","network":"eip155:43111","amount":"1000","asset":"0xad11a8BEb98bbf61dbb1aa0F6d6F2ECD87b35afA","payTo":"0x000000000000000000000000000000000000dEaD","maxTimeoutSeconds":300,"extra":{{"assetTransferMethod":"eip3009","name":"Bridged USDC (Stargate)","version":"2"}}}}}}"#,
+                nonce = "22".repeat(32),
+            );
+            serde_json::from_str(&json).unwrap()
+        };
+        let a = format!("0x{}1b", "11".repeat(64));
+        let b = format!("0x{}1c", "11".repeat(64));
+        assert_eq!(settlement_key(&request(&a)), settlement_key(&request(&a)));
+        assert_ne!(settlement_key(&request(&a)), settlement_key(&request(&b)));
+    }
+}
