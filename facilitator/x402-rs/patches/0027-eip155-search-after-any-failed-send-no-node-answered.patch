     /// Whether a transaction whose send failed is on its way after all.
     ///
-    /// A send that timed out may have reached a node, which may be the only one holding it until it is
-    /// mined, so the search then lasts two blocks. A send that was answered is looked up once.
-    async fn find_transaction(&self, tx_hash: TxHash, send_timed_out: bool) -> bool {
-        let search = if send_timed_out {
-            LOOKUP_WINDOW
-        } else {
-            Duration::ZERO
-        };
+    /// A send that no node answered may have reached one, which may be the only one holding it until it
+    /// is mined, so the caller can ask for a `search` of a block or two. The RPCs are always asked once.
+    async fn find_transaction(&self, tx_hash: TxHash, search: Duration) -> bool {
         let deadline = Instant::now() + search;
         loop {
             if self.transaction_is_known(tx_hash).await {
@@ -173,24 +168,55 @@ impl Eip155ChainProvider {
 /// unreachable after this long: the send moves on, and the failure counts against the RPC's rank.
 const RPC_REQUEST_TIMEOUT: Duration = Duration::from_secs(10);
 
-/// How long one RPC gets to answer a lookup of a transaction by hash. It is asked again.
-const LOOKUP_REQUEST_TIMEOUT: Duration = Duration::from_secs(3);
+/// How long one RPC gets to answer a lookup of a transaction by hash. Close to `RPC_REQUEST_TIMEOUT`:
+/// an RPC that is slow but answers must not hide a transaction it knows.
+const LOOKUP_REQUEST_TIMEOUT: Duration = Duration::from_secs(8);
 
-/// How long a transaction is looked for after a send that timed out: two of Hemi's 12 s blocks.
+/// How long a transaction is looked for after a send no node answered: two of Hemi's 12 s blocks.
 const LOOKUP_WINDOW: Duration = Duration::from_secs(25);
 
 /// The pause between lookups of a transaction by hash.
 const LOOKUP_INTERVAL: Duration = Duration::from_secs(3);
 
-/// What a send may add to the receipt timeout. Sending and waiting for the receipt together stay within
-/// the receipt timeout plus this, however slow the RPCs are. The 60 s receipt timeout then leaves 25 s
-/// of the 90 s the TS SDK gives `/settle` for the checks before the send.
+/// What a send may add to the receipt timeout. A slow send shortens the receipt wait and the search so
+/// that the whole takes about the receipt timeout plus this, which with the 60 s timeout leaves 25 s of
+/// the 90 s the TS SDK gives `/settle` for the checks before the send. This is a target, not a limit:
+/// a read or a round of lookups that has started runs to its own limit, so with every RPC slow the whole
+/// can run past it.
 const SEND_ALLOWANCE: Duration = Duration::from_secs(5);
 
-/// How long to wait for a receipt when `spent` of the send's time has gone. Zero reports the transaction
-/// as pending at once.
+/// How long to wait for a receipt when `spent` of the send's time has gone. At zero the wait ends after
+/// its first reads, and the transaction is reported as pending.
 fn receipt_wait(receipt_timeout: Duration, spent: Duration) -> Duration {
-    receipt_timeout.min((receipt_timeout + SEND_ALLOWANCE).saturating_sub(spent))
+    receipt_timeout.min(time_left(receipt_timeout, spent))
+}
+
+/// How much of a send's whole budget is left when `spent` has gone.
+fn time_left(receipt_timeout: Duration, spent: Duration) -> Duration {
+    (receipt_timeout + SEND_ALLOWANCE).saturating_sub(spent)
+}
+
+/// How long to search for a transaction whose send failed. A node's own rejection means it did not leave.
+/// Anything else says nothing: a timeout, a dropped connection, or a gateway's 5xx after it forwarded the
+/// transaction. The fallback layer reports only the last RPC's answer, so a rejection can hide such a
+/// failure on an earlier RPC. A rejection of a duplicate shows that, and so does the time a timeout took.
+/// The search ends with the send's budget.
+fn lookup_search(timed_out: bool, error: &TransportError, time_left: Duration) -> Duration {
+    let rejected = error
+        .as_error_resp()
+        .is_some_and(|response| !rejects_a_duplicate(&response.message));
+    if timed_out || !rejected {
+        LOOKUP_WINDOW.min(time_left)
+    } else {
+        Duration::ZERO
+    }
+}
+
+/// Whether a node's rejection means it already has this transaction, or has mined it. The text is only a
+/// hint to search, so a node that words it otherwise loses nothing but the search.
+fn rejects_a_duplicate(message: &str) -> bool {
+    let message = message.to_lowercase();
+    message.contains("already known") || message.contains("nonce too low")
 }
 
 /// An HTTP transport whose requests end after `timeout`.
@@ -441,8 +467,15 @@ impl Eip155MetaTransactionProvider for Eip155ChainProvider {
             // A failed send proves nothing if an RPC took the transaction and then stalled: the next RPC
             // rejects the copy while the first one's is mined. A node that knows the hash settles it.
             Err(e) => {
-                let send_timed_out = send_started.elapsed() >= RPC_REQUEST_TIMEOUT;
-                if self.find_transaction(tx_hash, send_timed_out).await {
+                let search = lookup_search(
+                    send_started.elapsed() >= RPC_REQUEST_TIMEOUT,
+                    &e,
+                    time_left(
+                        Duration::from_secs(self.receipt_timeout_secs),
+                        started.elapsed(),
+                    ),
+                );
+                if self.find_transaction(tx_hash, search).await {
                     #[cfg(feature = "telemetry")]
                     tracing::warn!(tx = %tx_hash, error = %e, "Send failed, but an RPC has the transaction");
                     PendingTransactionBuilder::new(self.inner.root().clone(), tx_hash)
@@ -653,7 +686,10 @@ pub async fn assert_contracts_exists<P: Provider>(
 
 #[cfg(test)]
 mod tests {
-    use super::{fallback_layer, fees_with_tip_floor, is_method_not_found, receipt_wait, rpc_http};
+    use super::{
+        LOOKUP_WINDOW, fallback_layer, fees_with_tip_floor, is_method_not_found, lookup_search,
+        receipt_wait, rpc_http,
+    };
     use alloy_provider::mock::{Asserter, MockTransport};
     use alloy_rpc_client::RpcClient;
     use alloy_transport::{TransportError, TransportErrorKind, TransportFut};
@@ -759,6 +795,44 @@ mod tests {
         assert_eq!(live.calls(), 1);
     }
 
+    async fn rejection(message: &str) -> TransportError {
+        let answers = Asserter::new();
+        answers.push_failure_msg(message.to_string());
+        let client = RpcClient::new(MockTransport::new(answers.clone()), false);
+        let send = client.request_noparams::<String>("eth_sendRawTransaction");
+        send.await.unwrap_err()
+    }
+
+    #[tokio::test]
+    async fn only_a_nodes_own_rejection_skips_the_search_for_a_failed_send() {
+        let plenty = Duration::from_secs(60);
+        let unreachable = TransportErrorKind::custom_str("502");
+        let rejected = rejection("insufficient funds for gas").await;
+
+        assert_eq!(lookup_search(false, &rejected, plenty), Duration::ZERO);
+        assert_eq!(lookup_search(false, &unreachable, plenty), LOOKUP_WINDOW);
+        assert_eq!(lookup_search(true, &unreachable, plenty), LOOKUP_WINDOW);
+        // A node rejected it, but only after an earlier RPC had timed out with the transaction.
+        assert_eq!(lookup_search(true, &rejected, plenty), LOOKUP_WINDOW);
+        // The search ends with the budget.
+        let little = Duration::from_secs(4);
+        assert_eq!(lookup_search(true, &unreachable, little), little);
+    }
+
+    // An earlier RPC took the transaction and failed fast, and this one refused the copy.
+    #[tokio::test]
+    async fn a_rejected_duplicate_is_searched_for() {
+        let plenty = Duration::from_secs(60);
+        for message in [
+            "already known",
+            "nonce too low: next nonce 8, tx nonce 7",
+            "Nonce too low",
+        ] {
+            let duplicate = rejection(message).await;
+            assert_eq!(lookup_search(false, &duplicate, plenty), LOOKUP_WINDOW);
+        }
+    }
+
     #[test]
     fn a_slow_send_shortens_the_receipt_wait() {
         let receipt_timeout = Duration::from_secs(60);
