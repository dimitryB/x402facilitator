+    /// A facilitator whose settlement waits for `release`, then signals `settled`.
+    #[derive(Clone, Default)]
+    struct SlowSettlement {
+        started: std::sync::Arc<tokio::sync::Notify>,
+        release: std::sync::Arc<tokio::sync::Notify>,
+        settled: std::sync::Arc<tokio::sync::Notify>,
+    }
+
+    impl Facilitator for SlowSettlement {
+        type Error = FacilitatorLocalError;
+
+        async fn verify(
+            &self,
+            _: &proto::VerifyRequest,
+        ) -> Result<proto::VerifyResponse, Self::Error> {
+            unreachable!()
+        }
+
+        fn settle(
+            &self,
+            _: &proto::SettleRequest,
+        ) -> impl Future<Output = Result<proto::SettleResponse, Self::Error>> + Send {
+            let me = self.clone();
+            async move {
+                me.started.notify_one();
+                me.release.notified().await;
+                me.settled.notify_one();
+                Ok(proto::SettleResponse(json!({ "success": true })))
+            }
+        }
+
+        async fn supported(&self) -> Result<proto::SupportedResponse, Self::Error> {
+            unreachable!()
+        }
+    }
+
+    #[tokio::test(flavor = "multi_thread")]
+    async fn a_settlement_outlives_a_client_that_disconnects() {
+        let facilitator = SlowSettlement::default();
+        let request: proto::SettleRequest = serde_json::from_str("{}").unwrap();
+        let handler = tokio::spawn(post_settle(State(facilitator.clone()), Ok(Json(request))));
+        facilitator.started.notified().await;
+        // The client goes away: axum drops the handler's future.
+        handler.abort();
+        match handler.await {
+            Err(join_error) => assert!(join_error.is_cancelled()),
+            Ok(_) => panic!("the handler finished before it was cancelled"),
+        }
+        facilitator.release.notify_one();
+        let settled = tokio::time::timeout(
+            std::time::Duration::from_secs(5),
+            facilitator.settled.notified(),
+        )
+        .await;
+        assert!(
+            settled.is_ok(),
+            "the settlement was cancelled with the request"
+        );
+    }
+
