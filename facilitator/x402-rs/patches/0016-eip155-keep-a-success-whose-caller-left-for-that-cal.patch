+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::atomic::{AtomicBool, Ordering};
+
+    #[test]
+    fn a_settle_caller_waits_until_told_otherwise() {
+        assert!(SettleCaller::waiting().is_waiting());
+        assert!(SettleCaller::default().is_waiting());
+        let gone = Arc::new(AtomicBool::new(false));
+        let caller = SettleCaller::new({
+            let gone = gone.clone();
+            move || !gone.load(Ordering::SeqCst)
+        });
+        assert!(caller.is_waiting());
+        gone.store(true, Ordering::SeqCst);
+        assert!(!caller.clone().is_waiting());
+    }
 }
