diff --git a/crates/x402-types/src/facilitator.rs b/crates/x402-types/src/facilitator.rs
index 655d9a5..68c0e03 100644
--- a/crates/x402-types/src/facilitator.rs
+++ b/crates/x402-types/src/facilitator.rs
@@ -9,6 +9,39 @@ use std::sync::Arc;
 
 use crate::proto;
 
+/// Tells a settlement whether its caller is still waiting for the outcome.
+///
+/// An HTTP server passes one that turns false when the client disconnects. A settlement that completes
+/// after that has nobody to report to, and a handler that keeps per-payment state can then keep the
+/// outcome for the caller's retry instead of discarding it.
+#[derive(Clone, Default)]
+pub struct SettleCaller(Option<Arc<dyn Fn() -> bool + Send + Sync>>);
+
+impl SettleCaller {
+    /// A caller that waits for the outcome: what [`Facilitator::settle`] assumes.
+    pub fn waiting() -> Self {
+        Self(None)
+    }
+
+    /// A caller that is waiting for as long as `is_waiting` returns true.
+    pub fn new(is_waiting: impl Fn() -> bool + Send + Sync + 'static) -> Self {
+        Self(Some(Arc::new(is_waiting)))
+    }
+
+    /// Whether the caller is still waiting for the outcome.
+    pub fn is_waiting(&self) -> bool {
+        self.0.as_ref().is_none_or(|is_waiting| is_waiting())
+    }
+}
+
+impl Debug for SettleCaller {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("SettleCaller")
+            .field("is_waiting", &self.is_waiting())
+            .finish()
+    }
+}
+
