+/// Marks a `/settle` request's caller as gone when the handler's future is dropped: by the client
+/// disconnecting, or by the handler ending, at which point the settlement has already returned.
+#[derive(Default)]
+struct HangUp(Arc<AtomicBool>);
+
+impl HangUp {
+    /// The [`SettleCaller`] that waits until this guard is dropped.
+    fn caller(&self) -> SettleCaller {
+        let gone = self.0.clone();
+        SettleCaller::new(move || !gone.load(Ordering::SeqCst))
+    }
+}
+
+impl Drop for HangUp {
+    fn drop(&mut self) {
+        self.0.store(true, Ordering::SeqCst);
+    }
+}
