     fn supported(&self) -> impl Future<Output = Result<C::SupportedResponse, Self::Error>> + Send;
+
+    /// [`Facilitator::settle`] for a caller that may stop waiting for the outcome, for example an
+    /// HTTP client that disconnects. The default ignores `caller`.
+    fn settle_for(
+        &self,
+        request: &C::SettleRequest,
+        caller: SettleCaller,
+    ) -> impl Future<Output = Result<C::SettleResponse, Self::Error>> + Send {
+        let _ = caller;
+        self.settle(request)
+    }
 }
 
 impl<C, T> Facilitator<C> for Arc<T>
@@ -123,4 +167,32 @@ where
     fn supported(&self) -> impl Future<Output = Result<C::SupportedResponse, Self::Error>> + Send {
         self.as_ref().supported()
     }
+
+    fn settle_for(
+        &self,
+        request: &C::SettleRequest,
+        caller: SettleCaller,
+    ) -> impl Future<Output = Result<C::SettleResponse, Self::Error>> + Send {
+        self.as_ref().settle_for(request, caller)
+    }
+}
