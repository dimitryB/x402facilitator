+    #[test]
+    fn permit2_nonce_position_matches_permit2_bitmap_layout() {
+        assert_eq!(
+            permit2_nonce_position(U256::ZERO),
+            (U256::ZERO, U256::from(1))
+        );
+        assert_eq!(
+            permit2_nonce_position(U256::from(257)),
+            (U256::from(1), U256::from(2))
+        );
+        assert_eq!(
+            permit2_nonce_position(U256::from(255)),
+            (U256::ZERO, U256::from(1) << 255)
+        );
+        assert_eq!(
+            permit2_nonce_position(U256::MAX),
+            (U256::MAX >> 8, U256::from(1) << 255)
+        );
+    }
