+/// Whether `error` comes from executing the transfer (a reverted simulation, gas estimate or
+/// transaction) rather than from a check of the payload. Only such failures are worth explaining
+/// by on-chain state, for example an authorization that was already used.
+pub fn is_failed_execution(error: &Eip155ExactError) -> bool {
+    matches!(
+        error,
+        Eip155ExactError::Transport(_)
+            | Eip155ExactError::ContractCall(_)
+            | Eip155ExactError::TransactionReverted(_)
+            | Eip155ExactError::PaymentVerification(
+                PaymentVerificationError::TransactionSimulation(_)
+            )
+    )
+}
+
+/// Explains a failed `transferWithAuthorization` simulation or send whose EIP-3009 authorization
+/// was already used (a replay, or the payer cancelled or spent it).
+///
+/// x402 v2 §9 has no replay-specific code. Such a transfer is one the chain rejects because of the
+/// authorization's on-chain state, which is what `invalid_transaction_state` ("Blockchain transaction
+/// failed or was rejected") describes; it is not an unexpected error, and retrying cannot succeed.
+/// The authorization state is read only after a failure, so successful payments cost no extra call.
+pub async fn explain_used_eip3009_authorization<T, P: Provider>(
+    contract: &IEIP3009::IEIP3009Instance<P>,
+    payment: &ExactEvmPayment,
+    result: Result<T, Eip155ExactError>,
+) -> Result<T, Eip155ExactError> {
+    let error = match result {
+        Ok(value) => return Ok(value),
+        Err(error) => error,
+    };
+    if is_failed_execution(&error)
+        && matches!(
+            contract
+                .authorizationState(payment.from, payment.nonce)
+                .call()
+                .await,
+            Ok(true)
+        )
+    {
+        Err(PaymentVerificationError::AuthorizationAlreadyUsed.into())
+    } else {
+        Err(error)
+    }
+}
