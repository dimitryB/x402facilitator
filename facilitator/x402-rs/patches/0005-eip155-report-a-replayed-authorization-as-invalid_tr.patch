+sol! {
+    /// Permit2's unordered-nonce bitmap (SignatureTransfer).
+    #[sol(rpc)]
+    interface IPermit2NonceBitmap {
+        function nonceBitmap(address owner, uint256 wordPos) external view returns (uint256);
+    }
+}
+
+/// Where Permit2 records an unordered nonce: word `nonce >> 8` of the owner's bitmap, bit `nonce & 0xff`.
+pub fn permit2_nonce_position(nonce: U256) -> (U256, U256) {
+    let bit = nonce.as_limbs()[0] as usize & 0xff;
+    (nonce >> 8, U256::from(1) << bit)
+}
+
+/// Explains a failed Permit2 settle simulation or send whose Permit2 nonce was already used
+/// (a replay, or the payer invalidated it).
+///
+/// x402 v2 §9 has no replay-specific code; `invalid_transaction_state` ("Blockchain transaction failed
+/// or was rejected") describes a transfer the chain rejects because of on-chain state. The nonce bitmap
+/// is read only after a failure, so successful payments cost no extra call. See
+/// [`crate::v1_eip155_exact::explain_used_eip3009_authorization`] for the EIP-3009 counterpart.
+pub async fn explain_used_permit2_nonce<T, P: Provider>(
+    provider: &P,
+    owner: Address,
+    nonce: U256,
+    result: Result<T, Eip155ExactError>,
+) -> Result<T, Eip155ExactError> {
+    let error = match result {
+        Ok(value) => return Ok(value),
+        Err(error) => error,
+    };
+    if !is_failed_execution(&error) {
+        return Err(error);
+    }
+    let (word, bit) = permit2_nonce_position(nonce);
+    let bitmap = IPermit2NonceBitmap::new(PERMIT2_ADDRESS, provider)
+        .nonceBitmap(owner, word)
+        .call()
+        .await;
+    match bitmap {
+        Ok(bitmap) if bitmap & bit != U256::ZERO => {
+            Err(PaymentVerificationError::AuthorizationAlreadyUsed.into())
+        }
+        _ => Err(error),
+    }
+}
