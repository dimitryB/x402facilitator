+/// A transaction's receipt, from whichever of `rpcs` has it first, looked for until `wait` has gone.
+///
+/// A shared request takes the first answer, and `null` from a node that lags is an answer, so a fast
+/// stale RPC would hide a receipt the others have for as long as it lags: a mined payment would be
+/// reported as pending. Each RPC is therefore asked on its own, and one that stalls holds up no other.
+/// Only a receipt ends the search early. Every RPC is asked at least once, so a `wait` of zero is one look.
+async fn find_receipt(
+    rpcs: &[RootProvider],
+    tx_hash: TxHash,
+    wait: Duration,
+) -> Option<TransactionReceipt> {
+    let deadline = Instant::now() + wait;
+    let mut lookups = JoinSet::new();
+    for rpc in rpcs {
+        let rpc = rpc.clone();
+        lookups.spawn(async move {
+            loop {
+                if let Ok(Some(receipt)) = rpc.get_transaction_receipt(tx_hash).await {
+                    return Some(receipt);
+                }
+                let left = deadline.saturating_duration_since(Instant::now());
+                if left.is_zero() {
+                    return None;
+                }
+                tokio::time::sleep(RECEIPT_INTERVAL.min(left)).await;
+            }
+        });
+    }
+    while let Some(lookup) = lookups.join_next().await {
+        if let Ok(Some(receipt)) = lookup {
+            return Some(receipt);
+        }
+    }
+    None
+}
