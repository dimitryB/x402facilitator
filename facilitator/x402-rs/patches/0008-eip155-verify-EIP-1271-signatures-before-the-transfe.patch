-/// Checks that `signature` is the payer's, reading nothing from the chain but, when needed, the payer's code.
+sol! {
+    /// EIP-1271 signature validation by a contract account.
+    #[sol(rpc)]
+    interface IERC1271 {
+        function isValidSignature(bytes32 hash, bytes signature) external view returns (bytes4 magicValue);
+    }
+}
+
+/// `IERC1271.isValidSignature.selector`: what a contract returns when it accepts a signature.
+pub const EIP1271_MAGIC_VALUE: [u8; 4] = [0x16, 0x26, 0xba, 0x7e];
+
+/// Asks `signer`'s contract whether it accepts `signature` for `hash` (EIP-1271), as the token or
+/// Permit2 will when the transfer executes. Any answer but the magic value, a revert included, is an
+/// invalid signature; only a failure to reach the chain is reported as such.
+pub async fn assert_eip1271_signature_valid<P: Provider>(
+    provider: &P,
+    signer: &Address,
+    hash: &B256,
+    signature: &Bytes,
+) -> Result<(), Eip155ExactError> {
+    let contract = IERC1271::new(*signer, provider);
+    let call = contract.isValidSignature(*hash, signature.clone());
+    match call.call().await {
+        Ok(magic) if magic.0 == EIP1271_MAGIC_VALUE => Ok(()),
+        Ok(magic) => Err(PaymentVerificationError::InvalidSignature(format!(
+            "{signer} does not accept the signature (isValidSignature returned {magic})"
+        ))
+        .into()),
+        Err(alloy_contract::Error::TransportError(e)) if !is_revert_response(&e) => {
+            Err(Eip155ExactError::Transport(e))
+        }
+        Err(e) => Err(PaymentVerificationError::InvalidSignature(format!(
+            "{signer} does not accept the signature: {e}"
+        ))
+        .into()),
+    }
+}
+
+/// Whether a JSON-RPC error is an execution revert rather than an RPC failure.
+fn is_revert_response(error: &TransportError) -> bool {
+    error
+        .as_error_resp()
+        .is_some_and(|payload| payload.message.contains("revert"))
+}
