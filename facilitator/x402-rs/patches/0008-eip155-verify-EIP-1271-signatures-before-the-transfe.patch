-/// Explains a failed `transferWithAuthorization` simulation or send whose EIP-3009 authorization
-/// was already used (a replay, or the payer cancelled or spent it).
+/// Permit2's signature errors: `InvalidSignature()`, `InvalidSigner()`, `InvalidContractSignature()`
+/// and `InvalidSignatureLength()`.
+const PERMIT2_SIGNATURE_ERRORS: [[u8; 4]; 4] = [
+    [0x8b, 0xaa, 0x57, 0x9f],
+    [0x81, 0x5e, 0x1d, 0x64],
+    [0xb0, 0x66, 0x9c, 0xbc],
+    [0x4b, 0xe6, 0x32, 0x1b],
+];
+
+/// Whether a failed transfer reverted because the token or Permit2 rejected the signature: an
+/// `Error(string)` reason mentioning an invalid signature (FiatToken's "FiatTokenV2: invalid signature",
+/// "ECRecover: invalid signature", ...) or one of Permit2's signature errors.
+///
+/// This catches what the checks before the transfer cannot: for example an EIP-712 domain in the
+/// payment requirements that differs from the token's, or a counterfactual (EIP-6492) wallet.
+pub fn is_signature_revert(error: &Eip155ExactError) -> bool {
+    let is_signature_error = |data: &[u8]| {
+        data.get(..4)
+            .is_some_and(|selector| PERMIT2_SIGNATURE_ERRORS.iter().any(|e| e == selector))
+            || Revert::abi_decode(data)
+                .is_ok_and(|revert| revert.reason.to_lowercase().contains("invalid signature"))
+    };
+    match error {
+        Eip155ExactError::Transport(e) => e
+            .as_error_resp()
+            .and_then(|payload| payload.as_revert_data())
+            .is_some_and(|data| is_signature_error(&data)),
+        // The EIP-6492 path simulates through Multicall3 and keeps the failure only as text.
+        Eip155ExactError::PaymentVerification(PaymentVerificationError::TransactionSimulation(
+            message,
+        )) => {
+            let message = message.to_lowercase();
+            message.contains("invalid signature")
+                // "invalid signature" inside ABI-encoded revert data
+                || message.contains("696e76616c6964207369676e6174757265")
+                || PERMIT2_SIGNATURE_ERRORS
+                    .iter()
+                    .any(|e| message.contains(&hex::encode(e)))
+        }
+        _ => false,
+    }
+}
