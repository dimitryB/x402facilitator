+/// Why no handler serves `request`: a network no handler serves is `invalid_network`
+/// ("Specified blockchain network is not supported", x402 v2 §9); a served network without the
+/// requested scheme or protocol version, or a request naming neither, is `unsupported_scheme`.
+fn no_handler_error(
+    handlers: &SchemeRegistry,
+    request: &proto::VerifyRequest,
+) -> PaymentVerificationError {
+    match request.scheme_handler_slug() {
+        Some(slug) if !handlers.supports_chain(&slug.chain_id) => {
+            PaymentVerificationError::UnsupportedChain
+        }
+        _ => PaymentVerificationError::UnsupportedScheme,
+    }
+}
+
 /// Errors that can occur during local facilitator operations.
 ///
 /// These errors wrap the underlying scheme handler errors and distinguish between
@@ -195,3 +210,44 @@ impl ErrorContext {
         Self { payer, ..self }
     }
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use x402_types::proto::{AsPaymentProblem, ErrorReason};
+
+    fn request(network: &str) -> proto::VerifyRequest {
+        serde_json::from_str(&format!(
+            r#"{{"x402Version":2,"paymentPayload":{{"x402Version":2,"accepted":{{"scheme":"exact","network":"{network}"}},"payload":{{}}}},"paymentRequirements":{{}}}}"#
+        ))
+        .unwrap()
+    }
+
+    fn reason(error: FacilitatorLocalError) -> (ErrorReason, ErrorContext) {
+        match error {
+            FacilitatorLocalError::Verification(e, context)
+            | FacilitatorLocalError::Settlement(e, context) => {
+                (e.as_payment_problem().reason(), context)
+            }
+        }
+    }
+
+    #[tokio::test]
+    async fn unknown_network_is_invalid_network() {
+        let facilitator = FacilitatorLocal::new(SchemeRegistry::default());
+        let request = request("eip155:1");
+        let (verify, context) = reason(facilitator.verify(&request).await.unwrap_err());
+        assert_eq!(verify, ErrorReason::InvalidNetwork);
+        assert_eq!(context.network.as_deref(), Some("eip155:1"));
+        let (settle, _) = reason(facilitator.settle(&request).await.unwrap_err());
+        assert_eq!(settle, ErrorReason::InvalidNetwork);
+    }
+
+    #[tokio::test]
+    async fn request_without_a_network_is_unsupported_scheme() {
+        let facilitator = FacilitatorLocal::new(SchemeRegistry::default());
+        let request: proto::VerifyRequest = serde_json::from_str(r#"{"x402Version":2}"#).unwrap();
+        let (verify, _) = reason(facilitator.verify(&request).await.unwrap_err());
+        assert_eq!(verify, ErrorReason::UnsupportedScheme);
+    }
+}
