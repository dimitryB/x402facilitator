+    /// Returns the payer named in `request`, if this handler can read it.
+    ///
+    /// Used to fill `payer` in `/verify` and `/settle` error responses
+    /// (x402 v2 §5.3.2, §5.4.2). The default knows no payer, and the field is then omitted.
+    fn payer(&self, request: &proto::VerifyRequest) -> Option<String> {
+        let _ = request;
+        None
+    }
 }
 
