+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::facilitator_local::ErrorContext;
+
+    const PAYER: &str = "0x90F79bf6EB2c4f870365E785982E1f101E93b906";
+
+    fn context() -> ErrorContext {
+        ErrorContext {
+            payer: Some(PAYER.to_string()),
+            network: Some("eip155:43111".to_string()),
+        }
+    }
+
+    #[test]
+    fn verify_error_carries_payer_and_spec_message() {
+        let error = FacilitatorLocalError::Verification(
+            PaymentVerificationError::InsufficientFunds.into(),
+            context(),
+        );
+        let body = error.as_json_value().unwrap();
+        let message = "Onchain balance is not enough to cover the payment amount";
+        assert_eq!(
+            body,
+            json!({
+                "isValid": false,
+                "invalidReason": "insufficient_funds",
+                "invalidMessage": message,
+                "invalidReasonDetails": message,
+                "payer": PAYER,
+            })
+        );
+    }
+
+    #[test]
+    fn settle_error_carries_network_and_payer() {
+        let error = FacilitatorLocalError::Settlement(
+            PaymentVerificationError::InsufficientFunds.into(),
+            context(),
+        );
+        let body = error.as_json_value().unwrap();
+        assert_eq!(body["success"], json!(false));
+        assert_eq!(body["errorReason"], json!("insufficient_funds"));
+        assert_eq!(body["network"], json!("eip155:43111"));
+        assert_eq!(body["transaction"], json!(""));
+        assert_eq!(body["payer"], json!(PAYER));
+    }
+
+    #[test]
+    fn unknown_payer_is_omitted() {
+        let error = FacilitatorLocalError::Verification(
+            PaymentVerificationError::UnsupportedScheme.into(),
+            ErrorContext::default(),
+        );
+        let body = error.as_json_value().unwrap();
+        assert!(body.get("payer").is_none(), "{body}");
+    }
+
+    #[test]
+    fn unexpected_errors_name_the_endpoint() {
+        let onchain = || X402SchemeFacilitatorError::OnchainFailure("rpc down".to_string());
+        let verify = FacilitatorLocalError::Verification(onchain(), context());
+        assert_eq!(
+            verify.as_json_value().unwrap()["invalidReason"],
+            json!("unexpected_verify_error")
+        );
+        let settle = FacilitatorLocalError::Settlement(onchain(), context());
+        assert_eq!(
+            settle.as_json_value().unwrap()["errorReason"],
+            json!("unexpected_settle_error")
+        );
+    }
+
+    #[test]
+    fn status_codes_are_unchanged() {
+        let status = |e: FacilitatorLocalError| e.into_response().status();
+        let allowance = PaymentVerificationError::InsufficientAllowance.into();
+        assert_eq!(
+            status(FacilitatorLocalError::Verification(allowance, context())),
+            StatusCode::PRECONDITION_FAILED
+        );
+        let funds = PaymentVerificationError::InsufficientFunds.into();
+        assert_eq!(
+            status(FacilitatorLocalError::Settlement(funds, context())),
+            StatusCode::BAD_REQUEST
+        );
+        let onchain = X402SchemeFacilitatorError::OnchainFailure("x".to_string());
+        assert_eq!(
+            status(FacilitatorLocalError::Settlement(onchain, context())),
+            StatusCode::INTERNAL_SERVER_ERROR
+        );
+    }
+}
diff --git a/crates/x402-types/src/proto/mod.rs b/crates/x402-types/src/proto/mod.rs
index b7397f2..af1e832 100644
--- a/crates/x402-types/src/proto/mod.rs
+++ b/crates/x402-types/src/proto/mod.rs
@@ -150,6 +150,20 @@ impl VerifyRequest {
         self.0.get()
     }
 
+    /// Returns the network the request is for, as the request writes it:
+    /// `paymentPayload.accepted.network` (v2, a CAIP-2 chain id) or
+    /// `paymentPayload.network` (v1, a network name).
+    pub fn network(&self) -> Option<String> {
+        let value: serde_json::Value = serde_json::from_str(self.as_str()).ok()?;
+        let payload = value.get("paymentPayload")?;
+        payload
+            .get("accepted")
+            .and_then(|accepted| accepted.get("network"))
+            .or_else(|| payload.get("network"))?
+            .as_str()
+            .map(str::to_owned)
+    }
+
     /// Extracts the scheme handler slug from the request.
     ///
     /// This determines which scheme handler should process this payment
@@ -488,4 +502,20 @@ mod tests {
             ErrorReason::InvalidTransactionState
         );
     }
+
+    fn request(json: &str) -> VerifyRequest {
+        serde_json::from_str(json).unwrap()
+    }
+
+    #[test]
+    fn network_is_read_from_v2_and_v1_requests() {
+        let v2 = request(
+            r#"{"x402Version":2,"paymentPayload":{"accepted":{"network":"eip155:43111"}}}"#,
+        );
+        assert_eq!(v2.network().as_deref(), Some("eip155:43111"));
+        let v1 = request(r#"{"x402Version":1,"paymentPayload":{"network":"base-sepolia"}}"#);
+        assert_eq!(v1.network().as_deref(), Some("base-sepolia"));
+        let none = request(r#"{"x402Version":2,"paymentPayload":{}}"#);
+        assert_eq!(none.network(), None);
+    }
 }
