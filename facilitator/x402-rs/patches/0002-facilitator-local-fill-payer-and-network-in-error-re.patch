@@ -155,12 +161,37 @@ pub enum FacilitatorLocalError {
     ///
     /// This error occurs when the scheme handler fails to verify a payment,
     /// typically due to invalid signatures, unsupported schemes, or insufficient funds.
-    #[error(transparent)]
-    Verification(X402SchemeFacilitatorError),
+    #[error("{0}")]
+    Verification(X402SchemeFacilitatorError, ErrorContext),
     /// Payment settlement failed.
     ///
     /// This error occurs when the scheme handler fails to settle a payment on-chain,
     /// typically due to transaction failures or network issues.
-    #[error(transparent)]
-    Settlement(X402SchemeFacilitatorError),
+    #[error("{0}")]
+    Settlement(X402SchemeFacilitatorError, ErrorContext),
+}
+
+/// What a failed request says about itself, echoed in the error response
+/// (`payer` and `network`, x402 v2 §5.3.2 and §5.4.2).
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub struct ErrorContext {
+    /// The payer named in the request, if its scheme handler can read it.
+    pub payer: Option<String>,
+    /// The network the request is for, as written in the request.
+    pub network: Option<String>,
+}
+
+impl ErrorContext {
+    /// Context known before a scheme handler is chosen: the request's network.
+    pub fn from_request(request: &proto::VerifyRequest) -> Self {
+        Self {
+            payer: None,
+            network: request.network(),
+        }
+    }
+
+    /// The same context, with the payer reported by the scheme handler.
+    pub fn with_payer(self, payer: Option<String>) -> Self {
+        Self { payer, ..self }
+    }
 }
