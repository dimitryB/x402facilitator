+/// x402 v2 §9 has no generic `unexpected_error`; it names the endpoint that failed.
+fn spec_reason(reason: ErrorReason, unexpected: ErrorReason) -> ErrorReason {
+    match reason {
+        ErrorReason::UnexpectedError => unexpected,
+        reason => reason,
+    }
 }
 
