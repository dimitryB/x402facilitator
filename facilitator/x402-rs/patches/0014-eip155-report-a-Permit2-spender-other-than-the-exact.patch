 #[cfg_attr(feature = "telemetry", instrument(skip_all, err))]
+/// The permit must name the x402 exact proxy as its spender: the proxy is what binds the transfer to
+/// the witness's recipient. Any other spender is a malformed payload, x402 v2 §9 `invalid_payload`
+/// ("contains invalid data"); it is not a recipient mismatch, since the spender never receives funds.
+/// Checked before the signature, whose EIP-712 hash is built with the proxy as spender, so that such a
+/// payload is reported for what is wrong with it rather than as an invalid signature (as the TS
+/// reference facilitator does, `permit2.ts`).
+pub fn assert_exact_proxy_spender(
+    payment_payload: &Permit2PaymentPayload,
+) -> Result<(), PaymentVerificationError> {
+    let spender = payment_payload.payload.permit_2_authorization.spender.0;
+    if spender != EXACT_PERMIT2_PROXY_ADDRESS {
+        return Err(PaymentVerificationError::InvalidFormat(format!(
+            "Permit2 spender {spender} is not the x402 exact proxy {EXACT_PERMIT2_PROXY_ADDRESS}"
+        )));
+    }
+    Ok(())
+}
+
 pub fn assert_offchain_valid(
     payment_payload: &Permit2PaymentPayload,
     payment_requirements: &Permit2PaymentRequirements,
@@ -159,9 +181,7 @@ pub fn assert_offchain_valid(
 
     // Spender must be the x402ExactPermit2Proxy contract address
     let authorization = &payload.permit_2_authorization;
-    if authorization.spender.0 != EXACT_PERMIT2_PROXY_ADDRESS {
-        return Err(PaymentVerificationError::RecipientMismatch);
-    }
+    assert_exact_proxy_spender(payment_payload)?;
 
     // Correct recipient
     let witness = &authorization.witness;
@@ -678,6 +698,42 @@ mod tests {
         }
     }
 
+    fn permit2_payload(spender: &str) -> Permit2PaymentPayload {
+        let requirements = serde_json::json!({
+            "scheme": "exact", "network": "eip155:43111", "amount": "10",
+            "asset": "0xAA40c0c7644e0b2B224509571e10ad20d9C4ef28",
+            "payTo": "0x000000000000000000000000000000000000dEaD", "maxTimeoutSeconds": 300,
+            "extra": {"assetTransferMethod": "permit2"}
+        });
+        serde_json::from_value(serde_json::json!({
+            "x402Version": 2,
+            "accepted": requirements,
+            "payload": {
+                "signature": format!("0x{}1b", "11".repeat(64)),
+                "permit2Authorization": {
+                    "from": "0x90F79bf6EB2c4f870365E785982E1f101E93b906",
+                    "permitted": {"token": "0xAA40c0c7644e0b2B224509571e10ad20d9C4ef28", "amount": "10"},
+                    "spender": spender, "nonce": "1", "deadline": "9999999999",
+                    "witness": {"to": "0x000000000000000000000000000000000000dEaD", "validAfter": "0"}
+                }
+            }
+        }))
+        .unwrap()
+    }
+
+    #[test]
+    fn a_spender_other_than_the_exact_proxy_is_an_invalid_payload() {
+        use x402_types::proto::{AsPaymentProblem, ErrorReason};
+        let proxy = EXACT_PERMIT2_PROXY_ADDRESS.to_string();
+        assert!(assert_exact_proxy_spender(&permit2_payload(&proxy)).is_ok());
+        let other = permit2_payload("0x000000000000000000000000000000000000bEEF");
+        let error = assert_exact_proxy_spender(&other).unwrap_err();
+        assert_eq!(
+            error.as_payment_problem().reason(),
+            ErrorReason::InvalidPayload
+        );
+    }
+
