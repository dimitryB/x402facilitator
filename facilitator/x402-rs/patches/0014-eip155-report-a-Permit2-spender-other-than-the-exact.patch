+++ b/crates/chains/x402-chain-eip155/src/v2_eip155_exact/facilitator/permit2.rs
@@ -35,7 +35,9 @@ pub async fn verify_permit2_payment<P: Eip155MetaTransactionProvider + ChainProv
     payment_payload: &Permit2PaymentPayload,
     payment_requirements: &Permit2PaymentRequirements,
 ) -> Result<v2::VerifyResponse, Eip155ExactError> {
-    // 0. The signature is the payer's (x402 exact EVM, Permit2 verification step 1)
+    // 0. The permit names the x402 exact proxy as spender, and its signature is the payer's
+    //    (x402 exact EVM, Permit2 verification step 1)
+    assert_exact_proxy_spender(payment_payload)?;
     assert_permit2_signed_by_payer(provider.inner(), provider.chain(), payment_payload).await?;
 
     // 1. Verify offchain constraints
@@ -83,7 +85,9 @@ where
