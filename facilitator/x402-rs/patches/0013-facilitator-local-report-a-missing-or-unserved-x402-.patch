diff --git a/crates/x402-types/src/scheme/mod.rs b/crates/x402-types/src/scheme/mod.rs
index b9d9e1c..e4469e0 100644
--- a/crates/x402-types/src/scheme/mod.rs
+++ b/crates/x402-types/src/scheme/mod.rs
@@ -352,6 +352,22 @@ impl SchemeRegistry {
     pub fn supports_chain(&self, chain_id: &ChainId) -> bool {
         self.0.keys().any(|slug| &slug.chain_id == chain_id)
     }
+
+    /// Whether any handler serves x402 protocol version `x402_version`.
+    pub fn supports_version(&self, x402_version: u8) -> bool {
+        self.0.keys().any(|slug| slug.x402_version == x402_version)
+    }
+
+    /// The registry with `handler` added under `slug` (replacing any handler already there), for
+    /// registries assembled by hand rather than from configuration.
+    pub fn with_handler(
+        mut self,
+        slug: SchemeHandlerSlug,
+        handler: Box<dyn X402SchemeFacilitator>,
+    ) -> Self {
+        self.0.insert(slug, handler);
+        self
+    }
 }
 
 /// Configuration for a specific scheme.
