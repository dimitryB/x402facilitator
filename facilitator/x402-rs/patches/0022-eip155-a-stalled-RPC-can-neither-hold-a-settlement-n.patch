+/// How long one RPC gets to answer one request.
+///
+/// A read goes to every RPC and the first answer wins, but a transaction waits for its one RPC, so a node
+/// that accepts the connection and never answers would hold a settlement for ever. It counts as
+/// unreachable after this long: the send moves on, and the failure counts against the RPC's rank. With a
+/// chain's two RPCs the send plus the 60 s receipt wait stays under the 90 s the TS SDK gives `/settle`.
+const RPC_REQUEST_TIMEOUT: Duration = Duration::from_secs(10);
+
+/// An HTTP transport whose requests end after `timeout`.
+fn rpc_http(url: url::Url, timeout: Duration) -> Http<reqwest::Client> {
+    let client = reqwest::Client::builder()
+        .timeout(timeout)
+        .build()
+        .expect("HTTP client for an RPC");
+    Http::with_client(client, url)
+}
+
 /// How requests are shared between a chain's RPCs.
 ///
 /// A read goes to all of them at once and the first answer wins. A transaction must not, and by default
@@ -243,8 +262,9 @@ impl Eip155MetaTransactionProvider for Eip155ChainProvider {
