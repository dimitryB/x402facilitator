-        let pending_tx = match self.inner.send_transaction(txr).await {
-            Ok(pending) => pending,
+        // Sign here rather than inside the send, so that the hash is known whatever the send answers.
+        let filled = self.inner.fill(txr).await;
+        let signed =
+            filled.and_then(|tx| tx.try_into_envelope().map_err(TransportError::local_usage));
+        let signed = match signed {
+            Ok(signed) => signed,
             Err(e) => {
-                // Transaction submission failed - reset nonce to force requery
                 self.nonce_manager.reset_nonce(from_address).await;
                 return Err(MetaTransactionSendError::Transport(e));
             }
         };
+        let tx_hash = *signed.tx_hash();
+
+        // Send transaction with error handling for nonce reset
+        let pending_tx = match self.inner.send_tx_envelope(signed).await {
+            Ok(pending) => pending,
+            // A failed send proves nothing if an RPC took the transaction and then stalled: the next RPC
+            // rejects the copy while the first one's is mined. A node that knows the hash settles it.
+            Err(e) => match self.inner.get_transaction_by_hash(tx_hash).await {
+                Ok(Some(_)) => {
+                    #[cfg(feature = "telemetry")]
+                    tracing::warn!(tx = %tx_hash, error = %e, "Send failed, but the chain has the transaction");
+                    PendingTransactionBuilder::new(self.inner.root().clone(), tx_hash)
+                }
+                _ => {
+                    // Transaction submission failed - reset nonce to force requery
+                    self.nonce_manager.reset_nonce(from_address).await;
+                    return Err(MetaTransactionSendError::Transport(e));
+                }
+            },
+        };
 
