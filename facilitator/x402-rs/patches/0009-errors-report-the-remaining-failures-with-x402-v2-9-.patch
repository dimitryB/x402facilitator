+/// Any other revert of the transfer simulation or gas estimate is the chain rejecting the transfer
+/// (for example a paused or blacklisting token): `TransactionSimulation`, x402 v2 §9
+/// `invalid_transaction_state`. Errors that are not reverts, such as an unreachable RPC, stay as they are.
+pub fn reverted_transfer(error: Eip155ExactError) -> Eip155ExactError {
+    match &error {
+        Eip155ExactError::Transport(e) if is_revert_response(e) => {
+            PaymentVerificationError::TransactionSimulation(error.to_string()).into()
+        }
+        _ => error,
     }
 }
 
