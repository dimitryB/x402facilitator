+#[derive(Clone, Copy)]
+enum Endpoint {
+    Verify,
+    Settle,
+}
+
+/// The answer to a body that is not JSON at all: the endpoint's error shape with x402 v2 §9
+/// `invalid_payload`, instead of axum's plain-text rejection. Keeps the rejection's status code.
+fn unreadable_request(status: StatusCode, message: &str, endpoint: Endpoint) -> Response {
+    let body = match endpoint {
+        Endpoint::Verify => serde_json::to_value(VerificationErrorResponse {
+            is_valid: false,
+            invalid_reason: ErrorReason::InvalidPayload,
+            invalid_message: message,
+            invalid_reason_details: message,
+            payer: None,
+        }),
+        Endpoint::Settle => serde_json::to_value(SettlementErrorResponse {
+            success: false,
+            network: None,
+            transaction: "",
+            error_reason: ErrorReason::InvalidPayload,
+            error_message: message,
+            payer: None,
+        }),
+    };
+    match body {
+        Ok(body) => (status, Json(body)).into_response(),
+        Err(_) => status.into_response(),
+    }
+}
