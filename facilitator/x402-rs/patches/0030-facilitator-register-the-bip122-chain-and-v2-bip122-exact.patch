+#[cfg(feature = "chain-bip122")]
+impl X402SchemeFacilitatorBuilder<&ChainProvider> for V2Bip122Exact {
+    fn build(
+        &self,
+        provider: &ChainProvider,
+        config: Option<serde_json::Value>,
+    ) -> Result<Box<dyn X402SchemeFacilitator>, Box<dyn std::error::Error>> {
+        let bip122_provider = if let ChainProvider::Bip122(provider) = provider {
+            Arc::clone(provider)
+        } else {
+            return Err("V2Bip122Exact::build: provider must be a Bip122ChainProvider".into());
+        };
+        self.build(bip122_provider, config)
+    }
+}
