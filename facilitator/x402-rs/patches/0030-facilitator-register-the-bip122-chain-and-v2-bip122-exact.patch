+#[cfg(all(test, feature = "chain-bip122"))]
+mod tests {
+    use super::*;
+
+    const SETTLER: &str = "0x00000000000000000000000000000000000B7C01";
+
+    fn chains(json: &str) -> Result<ChainsConfig, serde_json::Error> {
+        serde_json::from_str(json)
+    }
+
+    #[test]
+    fn a_bip122_chain_parses_next_to_its_hemi_chain() {
+        let config = chains(&format!(
+            r#"{{
+              "eip155:43111": {{
+                "signers": ["0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a"],
+                "rpc": [{{ "http": "http://127.0.0.1:1" }}]
+              }},
+              "bip122:000000000019d6689c085ae165831e93": {{
+                "hemi": "eip155:43111",
+                "settler": "{SETTLER}",
+                "min_confirmations": {{ "default": 2, "floor": 1, "ceiling": 6 }}
+              }}
+            }}"#
+        ))
+        .unwrap();
+        let bitcoin = config
+            .iter()
+            .find_map(|chain| match chain {
+                ChainConfig::Bip122(config) => Some(config),
+                _ => None,
+            })
+            .unwrap();
+        assert_eq!(
+            bitcoin.chain_id().to_string(),
+            "bip122:000000000019d6689c085ae165831e93"
+        );
+        assert_eq!(bitcoin.hemi().to_string(), "eip155:43111");
+        assert_eq!(bitcoin.settler(), Some(SETTLER.parse().unwrap()));
+        assert_eq!(bitcoin.confirmations().default, 2);
+        // It serializes back under its CAIP-2 key.
+        let json = serde_json::to_value(&config).unwrap();
+        assert_eq!(
+            json["bip122:000000000019d6689c085ae165831e93"]["hemi"],
+            "eip155:43111"
+        );
+    }
+
+    #[test]
+    fn an_unknown_bitcoin_network_or_a_bad_settler_is_refused() {
+        for json in [
+            r#"{ "bip122:000000000019d6689c085ae165831e94": { "hemi": "eip155:43111", "settler": "" } }"#,
+            r#"{ "bip122:000000000019d6689c085ae165831e93": { "hemi": "eip155:43111", "settler": "0x12" } }"#,
+            r#"{ "bip122:000000000019d6689c085ae165831e93": { "settler": "" } }"#,
+        ] {
+            assert!(chains(json).is_err(), "{json}");
+        }
+    }
+}
