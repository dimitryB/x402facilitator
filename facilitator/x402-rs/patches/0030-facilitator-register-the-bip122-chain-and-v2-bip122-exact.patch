 /// Initializes providers for all configured chains. Each chain configuration
 /// is processed and a corresponding provider is created and stored.
 ///
+/// It takes two passes. The first builds every chain that has its own provider. The second builds
+/// each Bitcoin (`bip122`) chain from the provider of the Hemi chain it names, which is shared, not
+/// copied: a second provider for the same signer would have its own nonce manager, and settlements
+/// sent through the two could take the same nonce. A Bitcoin chain whose settler is not set is skipped.
+///
 /// # Errors
 ///
-/// Returns an error if any chain provider fails to initialize.
+/// Returns an error if any chain provider fails to initialize, or if a Bitcoin chain names a Hemi
+/// chain that is not configured.
 #[async_trait::async_trait]
 impl FromConfig<ChainsConfig> for ChainRegistry<ChainProvider> {
     async fn from_config(chains: &ChainsConfig) -> Result<Self, Box<dyn std::error::Error>> {
         let mut providers = HashMap::new();
         for chain in chains.iter() {
+            #[cfg(feature = "chain-bip122")]
+            if matches!(chain, ChainConfig::Bip122(_)) {
+                continue;
+            }
             let chain_provider = ChainProvider::from_config(chain).await?;
             providers.insert(chain_provider.chain_id(), chain_provider);
         }
+        #[cfg(feature = "chain-bip122")]
+        for chain in chains.iter() {
+            if let ChainConfig::Bip122(config) = chain
+                && let Some(provider) = bip122_provider(config, &providers).await?
+            {
+                providers.insert(provider.chain_id(), provider);
+            }
+        }
         Ok(Self::new(providers))
     }
 }
+
+/// The provider of a Bitcoin chain, built on its Hemi chain's provider; `None` when no settler is set.
+#[cfg(feature = "chain-bip122")]
+async fn bip122_provider(
+    config: &bip122::Bip122ChainConfig,
+    providers: &HashMap<ChainId, ChainProvider>,
+) -> Result<Option<ChainProvider>, Box<dyn std::error::Error>> {
+    let Some(settler) = config.settler() else {
+        #[cfg(feature = "telemetry")]
+        tracing::warn!(
+            chain = %config.chain_id(),
+            settler = %config.settler_source(),
+            "No X402BtcSettler address set; this Bitcoin network is not served"
+        );
+        return Ok(None);
+    };
+    let hemi = match providers.get(config.hemi()) {
+        Some(ChainProvider::Eip155(hemi)) => Arc::clone(hemi),
+        Some(_) => {
+            return Err(format!(
+                "{} records its payments on {}, which is not an EVM chain",
+                config.chain_id(),
+                config.hemi()
+            )
+            .into());
+        }
+        None => {
+            return Err(format!(
+                "{} records its payments on {}, which is not configured: add it to \"chains\"",
+                config.chain_id(),
+                config.hemi()
+            )
+            .into());
+        }
+    };
+    let provider = bip122::Bip122ChainProvider::new(config, settler, hemi).await?;
+    Ok(Some(ChainProvider::Bip122(Arc::new(provider))))
+}
+
+#[cfg(all(test, feature = "chain-bip122"))]
+mod tests {
+    use super::*;
+
+    fn registry(json: &str) -> Result<ChainRegistry<ChainProvider>, String> {
+        let chains: ChainsConfig = serde_json::from_str(json).unwrap();
+        tokio::runtime::Builder::new_current_thread()
+            .enable_all()
+            .build()
+            .unwrap()
+            .block_on(ChainRegistry::from_config(&chains))
+            .map_err(|e| e.to_string())
+    }
+
+    #[test]
+    fn a_bitcoin_chain_without_its_hemi_chain_is_a_startup_error() {
+        let error = registry(
+            r#"{ "bip122:000000000019d6689c085ae165831e93": {
+                   "hemi": "eip155:43111", "settler": "0x00000000000000000000000000000000000B7C01" } }"#,
+        )
+        .unwrap_err();
+        assert!(error.contains("eip155:43111"), "{error}");
+        assert!(error.contains("not configured"), "{error}");
+    }
+
+    #[test]
+    fn a_bitcoin_chain_without_a_settler_is_skipped() {
+        let registry = registry(
+            r#"{ "bip122:000000000933ea01ad0ee984209779ba": {
+                   "hemi": "eip155:743111", "settler": "$X402_TEST_SETTLER_THAT_IS_NEVER_SET" } }"#,
+        )
+        .unwrap();
+        let testnet3 = ChainId::new("bip122", "000000000933ea01ad0ee984209779ba");
+        assert!(registry.by_chain_id(testnet3).is_none());
+    }
+
+    #[test]
+    fn a_bitcoin_chain_cannot_be_built_on_its_own() {
+        let chains: ChainsConfig = serde_json::from_str(
+            r#"{ "bip122:000000000019d6689c085ae165831e93": {
+                   "hemi": "eip155:43111", "settler": "0x00000000000000000000000000000000000B7C01" } }"#,
+        )
+        .unwrap();
+        let error = tokio::runtime::Builder::new_current_thread()
+            .build()
+            .unwrap()
+            .block_on(ChainProvider::from_config(&chains[0]))
+            .unwrap_err();
+        assert!(error.to_string().contains("chain registry"), "{error}");
+    }
+}
