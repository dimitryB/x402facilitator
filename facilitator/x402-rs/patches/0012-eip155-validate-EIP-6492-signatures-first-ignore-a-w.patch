+            match Self::eoa_signature_by(&sig6492.innerSig, expected_signer, prehash) {
+                Some(eoa) => StructuredSignature::EOA(eoa),
+                None => StructuredSignature::EIP6492 {
+                    factory: sig6492.factory,
+                    factory_calldata: sig6492.factoryCalldata,
