-            StructuredSignature::EIP6492 {
-                factory: sig6492.factory,
-                factory_calldata: sig6492.factoryCalldata,
-                inner: sig6492.innerSig,
-                original: bytes,
+            // A wrapper around a signature the payer's own key made needs no wallet deployment:
