+    fn wrap_6492(inner: Bytes) -> Bytes {
+        let body = alloy_sol_types::SolValue::abi_encode_params(&Sig6492 {
+            factory: Address::repeat_byte(0xfa),
+            factoryCalldata: Bytes::from_static(&[0xde, 0xad]),
+            innerSig: inner,
+        });
+        let mut wrapped = body;
+        wrapped.extend_from_slice(&EIP6492_MAGIC_SUFFIX);
+        Bytes::from(wrapped)
+    }
+
+    #[test]
+    fn eip6492_wrapper_around_the_payers_own_signature_is_a_plain_eoa_signature() {
+        let payer = PrivateKeySigner::random();
+        let owner = PrivateKeySigner::random();
+        let hash = B256::repeat_byte(0x42);
+        let own = wrap_6492(Bytes::from(payer.sign_hash_sync(&hash).unwrap().as_bytes()));
+        let others = wrap_6492(Bytes::from(owner.sign_hash_sync(&hash).unwrap().as_bytes()));
+        assert!(matches!(
+            StructuredSignature::try_from_bytes(own, payer.address(), &hash).unwrap(),
+            StructuredSignature::EOA(_)
+        ));
+        assert!(matches!(
+            StructuredSignature::try_from_bytes(others, payer.address(), &hash).unwrap(),
+            StructuredSignature::EIP6492 { .. }
+        ));
+    }
+
+    async fn eip6492_check(asserter: &Asserter) -> Result<(), Eip155ExactError> {
+        assert_eip6492_signature_valid(
+            &mocked_provider(asserter),
+            &Address::repeat_byte(0x11),
+            &B256::repeat_byte(0x42),
+            &Bytes::from_static(&[1, 2, 3]),
+        )
+        .await
+    }
+
+    #[tokio::test]
+    async fn eip6492_signature_needs_the_validators_yes() {
+        let word = |value: bool| {
+            let mut word = [0u8; 32];
+            word[31] = value as u8;
+            Bytes::from(word)
+        };
+        let asserter = Asserter::new();
+        asserter.push_success(&word(true));
+        assert!(eip6492_check(&asserter).await.is_ok());
+
+        let asserter = Asserter::new();
+        asserter.push_success(&word(false));
+        assert!(is_invalid_signature(&eip6492_check(&asserter).await));
+
+        let asserter = Asserter::new();
+        asserter.push_failure(
+            serde_json::from_value(serde_json::json!({
+                "code": 3, "message": "execution reverted", "data": "0x"
+            }))
+            .unwrap(),
+        );
+        assert!(is_invalid_signature(&eip6492_check(&asserter).await));
+
+        let asserter = Asserter::new();
+        asserter.push_failure_msg("rate limited");
+        assert!(matches!(
+            eip6492_check(&asserter).await,
+            Err(Eip155ExactError::Transport(_))
+        ));
+    }
+
