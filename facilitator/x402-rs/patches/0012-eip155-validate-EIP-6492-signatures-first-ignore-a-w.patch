+/// Asks the EIP-6492 validator whether `signature` (the full wrapped signature) is `signer`'s for
+/// `hash`. The validator deploys the wallet through the signature's factory if it has no code yet,
+/// then checks the signature; run as an `eth_call`, nothing is deployed for real. A rejection or a
+/// revert is an invalid signature; only a failure to reach the chain is reported as such. This keeps
+/// an unauthenticated factory call from ever being sent: settle runs this check before anything else.
+pub async fn assert_eip6492_signature_valid<P: Provider>(
+    provider: &P,
+    signer: &Address,
+    hash: &B256,
+    signature: &Bytes,
+) -> Result<(), Eip155ExactError> {
+    let validator = Validator6492::new(VALIDATOR_ADDRESS, provider);
+    let call = validator.isValidSigWithSideEffects(*signer, *hash, signature.clone());
+    match call.call().await {
+        Ok(true) => Ok(()),
+        Ok(false) => Err(PaymentVerificationError::InvalidSignature(format!(
+            "The EIP-6492 validator does not accept the signature for {signer}"
+        ))
+        .into()),
+        Err(alloy_contract::Error::TransportError(e)) if !is_revert_response(&e) => {
+            Err(Eip155ExactError::Transport(e))
+        }
+        Err(e) => Err(PaymentVerificationError::InvalidSignature(format!(
+            "The EIP-6492 validator does not accept the signature for {signer}: {e}"
+        ))
+        .into()),
+    }
+}
