 ///   ([`assert_eip1271_signer_has_code`]), and that contract must accept it for `hash`, the EIP-712
 ///   hash the token or Permit2 will check ([`assert_eip1271_signature_valid`]).
-/// - An EIP-6492 signature is left to the on-chain validator, because the wallet may not be deployed yet.
+/// - An EIP-6492 signature (a wallet that may not be deployed yet) must be accepted by the EIP-6492
+///   validator ([`assert_eip6492_signature_valid`]).
 pub async fn assert_signed_by_payer<P: Provider>(
     provider: &P,
     signature: &StructuredSignature,
@@ -859,7 +895,10 @@ pub async fn assert_signed_by_payer<P: Provider>(
             assert_eip1271_signer_has_code(provider, payer).await?;
             assert_eip1271_signature_valid(provider, payer, hash, signature).await
         }
-        StructuredSignature::EOA(_) | StructuredSignature::EIP6492 { .. } => Ok(()),
+        StructuredSignature::EIP6492 { original, .. } => {
+            assert_eip6492_signature_valid(provider, payer, hash, original).await
+        }
+        StructuredSignature::EOA(_) => Ok(()),
     }
 }
 
