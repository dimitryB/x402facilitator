@@ -681,22 +691,76 @@ mod tests {
     }
 
     #[test]
-    fn status_codes_are_unchanged() {
-        let status = |e: FacilitatorLocalError| e.into_response().status();
-        let allowance = PaymentVerificationError::InsufficientAllowance.into();
-        assert_eq!(
-            status(FacilitatorLocalError::Verification(allowance, context())),
-            StatusCode::PRECONDITION_FAILED
+    fn status_codes_follow_the_ts_reference_facilitator() {
+        let status = |e: X402SchemeFacilitatorError| {
+            let verify = FacilitatorLocalError::Verification(e, context()).into_response();
+            verify.status()
+        };
+        let verdicts: Vec<X402SchemeFacilitatorError> = vec![
+            PaymentVerificationError::InsufficientAllowance.into(),
+            PaymentVerificationError::InsufficientFunds.into(),
+            PaymentVerificationError::InvalidExactEvmPayloadSignature("x".into()).into(),
+            PaymentVerificationError::AuthorizationAlreadyUsed.into(),
+            PaymentVerificationError::UnsupportedChain.into(),
+            PaymentVerificationError::UnsupportedScheme.into(),
+            PaymentVerificationError::UnsupportedX402Version.into(),
+            PaymentVerificationError::AssetMismatch.into(),
+            PaymentVerificationError::InvalidPermit2Spender("x".into()).into(),
+            X402SchemeFacilitatorError::SettlementPending {
+                transaction: "0x01".into(),
+                details: "x".into(),
+            },
+            X402SchemeFacilitatorError::TransactionFailed {
+                transaction: "0x01".into(),
+                details: "x".into(),
+            },
+        ];
+        for error in verdicts {
+            let name = format!("{error:?}");
+            assert_eq!(status(error), StatusCode::OK, "{name}");
+        }
+        for unreadable in [
+            PaymentVerificationError::InvalidFormat("x".into()),
+            PaymentVerificationError::InvalidX402Version("x".into()),
+        ] {
+            assert_eq!(status(unreadable.into()), StatusCode::BAD_REQUEST);
+        }
+        let onchain = X402SchemeFacilitatorError::OnchainFailure("x".to_string());
+        assert_eq!(status(onchain), StatusCode::INTERNAL_SERVER_ERROR);
+    }
+
+    /// x402-rs's own facilitator client (`x402-axum`) deserializes the body of a 200, 400 or 412 and
+    /// decides by its fields (`FacilitatorClient::post_json`, `PaygateProtocol::validate_verify_response`,
+    /// `validate_settlement_success`). A rejection answered with 200 must read as one.
+    #[test]
+    fn a_rejection_reads_as_one_for_the_x402_axum_client() {
+        use x402_types::proto::v2;
+        let rejected = FacilitatorLocalError::Verification(
+            PaymentVerificationError::InsufficientFunds.into(),
+            context(),
         );
-        let funds = PaymentVerificationError::InsufficientFunds.into();
-        assert_eq!(
-            status(FacilitatorLocalError::Settlement(funds, context())),
-            StatusCode::BAD_REQUEST
+        let body = rejected.as_json_value().unwrap();
+        let parsed = v2::VerifyResponse::try_from(proto::VerifyResponse(body)).unwrap();
+        assert!(matches!(
+            parsed,
+            v2::VerifyResponse::Invalid { ref reason, .. } if reason == "insufficient_funds"
+        ));
+        let allowance = FacilitatorLocalError::Verification(
+            PaymentVerificationError::InsufficientAllowance.into(),
+            context(),
         );
-        let onchain = X402SchemeFacilitatorError::OnchainFailure("x".to_string());
-        assert_eq!(
-            status(FacilitatorLocalError::Settlement(onchain, context())),
-            StatusCode::INTERNAL_SERVER_ERROR
+        let parsed =
+            v2::VerifyResponse::try_from(proto::VerifyResponse(allowance.as_json_value().unwrap()))
+                .unwrap();
+        // x402-axum answers the buyer 412 for this reason, read from the body.
+        assert!(matches!(
+            parsed,
+            v2::VerifyResponse::Invalid { ref reason, .. } if reason == "permit2_allowance_required"
+        ));
+        let failed = FacilitatorLocalError::Settlement(
+            PaymentVerificationError::InsufficientFunds.into(),
+            context(),
         );
+        assert_eq!(failed.as_json_value().unwrap()["success"], json!(false));
     }
 }
