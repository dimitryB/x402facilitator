+/// HTTP status codes as the x402 TS reference facilitator answers (`x402-foundation/x402`,
+/// `examples/typescript/facilitator/basic/index.ts`):
+///
+/// - 200 for every verdict on a payment that could be read: `isValid: false` or `success: false`
+///   with its §9 code, including `permit2_allowance_required`, `settlement_pending` and a reverted
+///   settlement. The reference sends whatever `verify` or `settle` returns with `res.json`. The
+///   resource server, not the facilitator, turns the code into its own status (402, or 412 for
+///   `permit2_allowance_required`), and the TS client only reads the code as-is from a 2xx answer: it
+///   turns any other status into an exception whose message is "<code>: <message>".
+/// - 400 for a request that cannot be read as a payment: the reference's 400s for a body without
+///   `paymentPayload` or `paymentRequirements`, or with a payload that is not an object or has
+///   neither `authorization` nor `permit2Authorization`. Here: `invalid_payload` for a payload that
+///   does not parse, and `invalid_x402_version` for a version that cannot be read.
+/// - 500 for an unexpected failure (an RPC that cannot be reached), as the reference does when
+///   `verify` or `settle` throws.
 fn scheme_error_to_status_code(error: &X402SchemeFacilitatorError) -> StatusCode {
     match error {
-        X402SchemeFacilitatorError::PaymentVerification(e) => {
-            if let PaymentVerificationError::InsufficientAllowance = e {
-                StatusCode::PRECONDITION_FAILED
-            } else {
-                StatusCode::BAD_REQUEST
-            }
-        }
+        X402SchemeFacilitatorError::PaymentVerification(
+            PaymentVerificationError::InvalidFormat(_)
+            | PaymentVerificationError::InvalidX402Version(_),
+        ) => StatusCode::BAD_REQUEST,
+        X402SchemeFacilitatorError::PaymentVerification(_)
+        | X402SchemeFacilitatorError::SettlementPending { .. }
+        | X402SchemeFacilitatorError::TransactionFailed { .. } => StatusCode::OK,
         X402SchemeFacilitatorError::OnchainFailure(_) => StatusCode::INTERNAL_SERVER_ERROR,
-        // Not a failed request: the transaction is out and may still be mined. Like the TS reference
-        // facilitator, answer it as an ordinary settle response, so that clients read the body and
-        // its transaction hash (x402-rs's own facilitator client ignores the body of a 5xx).
-        X402SchemeFacilitatorError::SettlementPending { .. } => StatusCode::OK,
-        // The payment failed on chain, like any other invalid_transaction_state: 400.
-        X402SchemeFacilitatorError::TransactionFailed { .. } => StatusCode::BAD_REQUEST,
     }
 }
 
