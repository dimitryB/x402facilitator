-    assert_enough_balance(&contract, &authorization.from, amount_required).await?;
-
     let signature = payload.signature.clone();
 
     let payment = ExactEvmPayment {
@@ -115,6 +106,21 @@ pub async fn assert_valid_payment<P: Provider>(
         signature,
     };
 
+    // The signature comes first (x402 exact EVM, EIP-3009 verification step 1), before the balance read.
+    assert_payment_signed_by_payer(contract.provider(), &payment, &domain).await?;
+
+    if authorization.to != accepted.pay_to {
+        return Err(PaymentVerificationError::RecipientMismatch.into());
+    }
+    let valid_after = authorization.valid_after;
+    let valid_before = authorization.valid_before;
