+/// Reports signature failures with the code x402 v2 §9 gives them for the exact scheme on EVM,
+/// `invalid_exact_evm_payload_signature`, instead of the chain-agnostic `invalid_signature`.
+fn exact_evm_error(error: X402SchemeFacilitatorError) -> X402SchemeFacilitatorError {
+    match error {
+        X402SchemeFacilitatorError::PaymentVerification(
+            PaymentVerificationError::InvalidSignature(message),
+        ) => PaymentVerificationError::InvalidExactEvmPayloadSignature(message).into(),
+        error => error,
+    }
+}
+
