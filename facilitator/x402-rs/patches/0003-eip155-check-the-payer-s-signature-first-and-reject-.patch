+/// Rejects a signature that only an EIP-1271 contract could validate when `signer` has no code.
+///
+/// [`StructuredSignature::try_from_bytes`] treats a 64/65-byte signature that does not recover to the
+/// expected signer as an EIP-1271 signature, so that smart wallets keep working. An address without code
+/// cannot validate EIP-1271 signatures, so for such a signer the signature is simply invalid.
+/// Counterfactual wallets are not affected: their signatures are EIP-6492-wrapped and never take this path.
+pub async fn assert_eip1271_signer_has_code<P: Provider>(
+    provider: &P,
+    signer: &Address,
+) -> Result<(), Eip155ExactError> {
+    if is_contract_deployed(provider, signer).await? {
+        Ok(())
+    } else {
+        Err(PaymentVerificationError::InvalidSignature(format!(
+            "Signature was not made by {signer}, which has no code to validate it as an EIP-1271 signature"
+        ))
+        .into())
+    }
+}
+
+/// Checks that `signature` is the payer's, reading nothing from the chain but, when needed, the payer's code.
+///
+/// x402's `exact` scheme on EVM checks the signature first, before balances and allowances
+/// (`scheme_exact_evm.md`: EIP-3009 verification step 1, Permit2 verification step 1). An EOA signature
+/// already recovered to the payer when it was parsed; an EIP-1271 one is only possible from a contract
+/// ([`assert_eip1271_signer_has_code`]); an EIP-6492 one is left to the on-chain validator, because the
+/// wallet may not be deployed yet.
+pub async fn assert_signed_by_payer<P: Provider>(
+    provider: &P,
+    signature: &StructuredSignature,
+    payer: &Address,
+) -> Result<(), Eip155ExactError> {
+    match signature {
+        StructuredSignature::EIP1271(_) => assert_eip1271_signer_has_code(provider, payer).await,
+        StructuredSignature::EOA(_) | StructuredSignature::EIP6492 { .. } => Ok(()),
+    }
+}
+
+/// [`assert_signed_by_payer`] for an EIP-3009 `transferWithAuthorization` payment.
+pub async fn assert_payment_signed_by_payer<P: Provider>(
+    provider: &P,
+    payment: &ExactEvmPayment,
+    eip712_domain: &Eip712Domain,
+) -> Result<(), Eip155ExactError> {
+    let signed_message = payment.as_signed_message(eip712_domain)?;
+    assert_signed_by_payer(provider, &signed_message.signature, &signed_message.address).await
+}
+
 pub async fn verify_payment<P: Provider>(
     provider: &P,
     contract: &IEIP3009::IEIP3009Instance<&P>,
@@ -1114,3 +1162,72 @@ impl From<alloy_contract::Error> for Eip155ExactError {
         }
     }
 }
