+/// Checks that the Permit2 signature is the payer's (x402 exact EVM, Permit2 verification step 1),
+/// before allowance, balance or simulation; see [`assert_signed_by_payer`].
+pub async fn assert_permit2_signed_by_payer<P: Provider>(
+    provider: &P,
+    chain_reference: &Eip155ChainReference,
+    payment_payload: &Permit2PaymentPayload,
+) -> Result<(), Eip155ExactError> {
+    let prepared = PreparedExactPermit2::try_new(chain_reference, payment_payload)?;
+    assert_signed_by_payer(provider, &prepared.structured_signature, &prepared.payer).await
+}
