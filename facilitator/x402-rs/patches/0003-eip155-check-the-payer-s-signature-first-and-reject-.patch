+#[cfg(test)]
+mod tests {
+    use super::*;
+    use alloy_provider::ProviderBuilder;
+    use alloy_signer::SignerSync;
+    use alloy_signer_local::PrivateKeySigner;
+    use alloy_transport::mock::Asserter;
+
+    fn mocked_provider(asserter: &Asserter) -> impl Provider {
+        ProviderBuilder::new().connect_mocked_client(asserter.clone())
+    }
+
+    #[test]
+    fn signature_by_another_key_is_classified_as_eip1271() {
+        let payer = PrivateKeySigner::random();
+        let other = PrivateKeySigner::random();
+        let hash = B256::repeat_byte(0x42);
+        let own = Bytes::from(payer.sign_hash_sync(&hash).unwrap().as_bytes());
+        let foreign = Bytes::from(other.sign_hash_sync(&hash).unwrap().as_bytes());
+        assert!(matches!(
+            StructuredSignature::try_from_bytes(own, payer.address(), &hash).unwrap(),
+            StructuredSignature::EOA(_)
+        ));
+        assert!(matches!(
+            StructuredSignature::try_from_bytes(foreign, payer.address(), &hash).unwrap(),
+            StructuredSignature::EIP1271(_)
+        ));
+    }
+
+    #[tokio::test]
+    async fn eoa_signature_needs_no_rpc_call() {
+        let payer = PrivateKeySigner::random();
+        let hash = B256::repeat_byte(0x42);
+        let own = Bytes::from(payer.sign_hash_sync(&hash).unwrap().as_bytes());
+        let signature = StructuredSignature::try_from_bytes(own, payer.address(), &hash).unwrap();
+        // No response is queued: any RPC call would fail the check.
+        let asserter = Asserter::new();
+        let result =
+            assert_signed_by_payer(&mocked_provider(&asserter), &signature, &payer.address()).await;
+        assert!(result.is_ok(), "{result:?}");
+    }
+
+    #[tokio::test]
+    async fn eip1271_signature_from_an_address_without_code_is_invalid() {
+        let asserter = Asserter::new();
+        asserter.push_success(&Bytes::new());
+        let signer = Address::repeat_byte(0x11);
+        let result = assert_eip1271_signer_has_code(&mocked_provider(&asserter), &signer).await;
+        assert!(
+            matches!(
+                result,
+                Err(Eip155ExactError::PaymentVerification(
+                    PaymentVerificationError::InvalidSignature(_)
+                ))
+            ),
+            "{result:?}"
+        );
+    }
+
+    #[tokio::test]
+    async fn eip1271_signature_from_a_contract_is_left_to_the_contract() {
+        let asserter = Asserter::new();
+        asserter.push_success(&Bytes::from_static(&[0x60, 0x80, 0x60, 0x40]));
+        let signer = Address::repeat_byte(0x11);
+        let result = assert_eip1271_signer_has_code(&mocked_provider(&asserter), &signer).await;
+        assert!(result.is_ok(), "{result:?}");
+    }
+}
