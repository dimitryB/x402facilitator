{
  "_about": "How every implementation of the exact bip122 scheme reads the extra fields of an accept: a buyer pays only what the facilitator accepts, so both must agree on each case. Each case applies `set` and `remove` to base.extra; `accept` cases give the values the fields resolve to (minConfirmations null: absent, the facilitator's default applies), reject cases name the field the error is about. Run by btc/test/requirements-cases.test.ts and the x402-chain-bip122 crate (types.rs); its copy, facilitator/x402-rs/crates/x402-chain-bip122/requirements-cases.json, must stay identical (a btc test checks).",
  "base": {
    "scheme": "exact",
    "network": "bip122:000000000019d6689c085ae165831e93",
    "amount": "1000",
    "asset": "BTC",
    "payTo": "xpub6CatWdiZiodmUeTDp8LT5or8nmbKNcuyvz7WyksVFkKB4RHwCD3XyuvPEbvqAQY3rAPshWcMLoP2fMFMKHPJ4ZeZXYVUhLv1VMrjPC7PW6V",
    "maxTimeoutSeconds": 7200,
    "extra": {
      "assetTransferMethod": "utxo",
      "paymentFlow": "upfront",
      "paymentId": "00112233445566778899aabbccddeeff",
      "addressType": "p2wpkh",
      "minConfirmations": 1
    }
  },
  "cases": [
    { "name": "all fields present", "accept": true, "addressType": "p2wpkh", "minConfirmations": 1 },
    { "name": "addressType absent: p2wpkh", "remove": ["addressType"], "accept": true, "addressType": "p2wpkh", "minConfirmations": 1 },
    { "name": "addressType p2tr", "set": { "addressType": "p2tr" }, "accept": true, "addressType": "p2tr", "minConfirmations": 1 },
    { "name": "addressType null", "set": { "addressType": null }, "accept": false, "field": "addressType" },
    { "name": "addressType p2pkh", "set": { "addressType": "p2pkh" }, "accept": false, "field": "addressType" },
    { "name": "addressType in upper case", "set": { "addressType": "P2WPKH" }, "accept": false, "field": "addressType" },
    { "name": "addressType a number", "set": { "addressType": 1 }, "accept": false, "field": "addressType" },
    { "name": "minConfirmations absent", "remove": ["minConfirmations"], "accept": true, "addressType": "p2wpkh", "minConfirmations": null },
    { "name": "minConfirmations 6", "set": { "minConfirmations": 6 }, "accept": true, "addressType": "p2wpkh", "minConfirmations": 6 },
    { "name": "minConfirmations 1.0 (a whole number written with a fraction)", "set": { "minConfirmations": 1.0 }, "accept": true, "addressType": "p2wpkh", "minConfirmations": 1 },
    { "name": "minConfirmations 2^32 - 1", "set": { "minConfirmations": 4294967295 }, "accept": true, "addressType": "p2wpkh", "minConfirmations": 4294967295 },
    { "name": "minConfirmations null", "set": { "minConfirmations": null }, "accept": false, "field": "minConfirmations" },
    { "name": "minConfirmations 0", "set": { "minConfirmations": 0 }, "accept": false, "field": "minConfirmations" },
    { "name": "minConfirmations -1", "set": { "minConfirmations": -1 }, "accept": false, "field": "minConfirmations" },
    { "name": "minConfirmations 1.5", "set": { "minConfirmations": 1.5 }, "accept": false, "field": "minConfirmations" },
    { "name": "minConfirmations 2^32", "set": { "minConfirmations": 4294967296 }, "accept": false, "field": "minConfirmations" },
    { "name": "minConfirmations a string", "set": { "minConfirmations": "1" }, "accept": false, "field": "minConfirmations" },
    { "name": "assetTransferMethod absent", "remove": ["assetTransferMethod"], "accept": false, "field": "assetTransferMethod" },
    { "name": "assetTransferMethod null", "set": { "assetTransferMethod": null }, "accept": false, "field": "assetTransferMethod" },
    { "name": "paymentFlow absent", "remove": ["paymentFlow"], "accept": false, "field": "paymentFlow" },
    { "name": "paymentFlow null", "set": { "paymentFlow": null }, "accept": false, "field": "paymentFlow" },
    { "name": "paymentId absent", "remove": ["paymentId"], "accept": false, "field": "paymentId" },
    { "name": "paymentId null", "set": { "paymentId": null }, "accept": false, "field": "paymentId" }
  ]
}
