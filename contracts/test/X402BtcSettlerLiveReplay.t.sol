// Ported from the internal security review of 2026-11-09 (D-038): raw mainnet hBK answers, captured from
// 0x7007dd1C09527B92AEcd8Ae6570B73d09E0B8F12 with cast, replayed through the settler.
pragma solidity 0.8.28;
import {Test} from "forge-std/Test.sol";
import {X402BtcSettler} from "../src/btc/X402BtcSettler.sol";
import {RawHbk} from "./X402BtcSettlerAudit.t.sol";

/// Replays raw mainnet hBK answers captured 2026-11-09 from 0x7007dd1C09527B92AEcd8Ae6570B73d09E0B8F12.
contract LiveReplayTest is Test {
    bytes constant WP0 =
        hex""; // 54e48e5f… vout 0: 1 sat, 201-byte bare multisig cut to 64
    bytes constant OPR0 =
        hex""; // 8bae12b5… vout 0: OP_RETURN "charley loves heidi"
    bytes constant OPR1 =
        hex""; // 8bae12b5… vout 1: P2PKH 200000 sats, spent
    bytes constant P2PKH = hex"76a914b8268ce4d481413c4e848ff353cd16104291c45b88ac";
    RawHbk raw;
    X402BtcSettler s;
    address f = makeAddr("f");

    function setUp() public {
        raw = new RawHbk();
        s = new X402BtcSettler(address(raw), f, 0);
    }

    function test_wp0_cutScriptIsMismatch() public {
        raw.set(WP0, abi.encode(uint32(745_204)));
        bytes memory cut = new bytes(64);
        for (uint256 i; i < 64; i++) {
            cut[i] = WP0[32 * 10 + i];
        }
        X402BtcSettler.Check memory c = s.verify(bytes32(0), 0, cut, 1, 1);
        assertEq(uint8(c.verdict), uint8(X402BtcSettler.Verdict.ScriptMismatch));
        assertEq(c.sats, 1);
    }

    function test_opr0_isOpReturn() public {
        raw.set(OPR0, abi.encode(uint32(666_643)));
        X402BtcSettler.Check memory c = s.verify(bytes32(0), 0, hex"6a13636861726c6579206c6f766573206865696469", 0, 1);
        assertEq(uint8(c.verdict), uint8(X402BtcSettler.Verdict.OpReturn));
    }

    function test_opr1_p2pkhOk() public {
        raw.set(OPR1, abi.encode(uint32(666_643)));
        X402BtcSettler.Check memory c = s.verify(bytes32(0), 1, P2PKH, 200_000, 6);
        assertEq(uint8(c.verdict), uint8(X402BtcSettler.Verdict.Ok));
        assertEq(c.sats, 200_000);
        assertFalse(c.isSpent); // word 6 of the live answer is 0
        assertEq(uint8(s.verify(bytes32(0), 1, P2PKH, 200_001, 6).verdict), uint8(X402BtcSettler.Verdict.BelowAmount));
    }
}
